{% schema %}
{
  "name": "USA Golf Courses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "USA Golf Courses"
    }
  ]
}
{% endschema %}

<section class="golf-courses-section color-{{ section.settings.color_scheme }}">
  <!-- 1) Gather All Courses -->
  {% assign all_courses = shop.metaobjects.courses.values %}

  <!-- 2) Build a Unique List of States -->
  {% assign states_csv = '' %}
  {% for course in all_courses %}
    {% if course.state and course.state.value != blank %}
      {% unless states_csv contains course.state.value %}
        {% assign states_csv = states_csv | append: course.state.value | append: ',' %}
      {% endunless %}
    {% endif %}
  {% endfor %}
  {% assign states_array = states_csv | split: ',' | uniq %}

  <!-- 3) Section Header -->
  <div class="golf-courses-container">
    <div class="section-header">
      <h2 class="section-title">Golf Courses by State</h2>
    </div>

    <!-- 4) Loop Through Each State & Show Its Courses -->
    <div class="golf-courses-grid">
      {% for st in states_array %}
        {% if st != blank %}
          <div class="golf-course-state">
            <h3>{{ st }}</h3>
            <ul class="courses-list">
              {% for course in all_courses %}
                {% if course.state and course.state.value == st %}
                  <li>
                    <a
                      href="/pages/courses/{{ course.system.handle }}"
                      class="golf-course-link"
                    >
                      {{ course.title }}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- (Optional) 5) Featured Destinations -->
  {% assign has_featured_destinations = false %}
  {% for course in all_courses %}
    {% if course.featured_destination == true %}
      {% assign has_featured_destinations = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_featured_destinations %}
    <div class="golf-courses-container">
      <div class="section-header">
        <h2 class="section-title">USA Featured Golf Destinations</h2>
      </div>
      <div class="golf-courses-grid">
        {% for st in states_array %}
          <!-- Only print states that contain a featured course -->
          {% assign has_featured_in_state = false %}
          {% for course in all_courses %}
            {% if course.featured_destination == true and course.state and course.state.value == st %}
              {% assign has_featured_in_state = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% if has_featured_in_state %}
            <div class="golf-course-state">
              <h3>{{ st }}</h3>
              <ul class="courses-list">
                {% for course in all_courses %}
                  {% if course.featured_destination == true and course.state and course.state.value == st %}
                    <li>
                      <a
                        href="/pages/courses/{{ course.system.handle }}"
                        class="golf-course-link"
                      >
                        {{ course.title }}
                      </a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  /* 🌟 Scoped Section Styling */
  .golf-courses-section {
    text-align: center;
    padding: 40px 20px;
    position: relative;
  }

  /* 🌟 Scoped Container */
  .golf-courses-section .golf-courses-container {
    margin-bottom: 40px;
    position: relative;
  }

  /* 🌟 Scoped Title Wrapper */
  .golf-courses-section .section-header {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    position: relative;
    padding: 10px 0;
  }

  /* 🌟 Scoped Section Titles */
  .golf-courses-section .section-title {
    font-size: 22px;
    font-weight: bold;
    text-transform: uppercase;
    color: #c3996b !important; /* Golden Color */
    position: relative;
    background-color: var(--color-background);
    padding: 0 20px;
    z-index: 2;
    white-space: nowrap;
  }

  /* 🌟 Force Title Bars to Show */
  .golf-courses-section .section-header::before,
  .golf-courses-section .section-header::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: #c3996b !important;
    display: block;
  }
  .golf-courses-section .section-header::before {
    margin-right: 15px;
  }
  .golf-courses-section .section-header::after {
    margin-left: 15px;
  }

  /* 🌟 Scoped Grid Layout */
  .golf-courses-section .golf-courses-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    max-width: 900px;
    margin: 0 auto;
    text-align: left;
  }

  /* 🌟 Each "State" Card */
  .golf-course-state {
    padding: 10px;
    background: var(--color-card-background, #fff);
    border-radius: 4px;
  }

  .golf-course-state h3 {
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--color-heading, #333);
  }

  .courses-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .courses-list li {
    margin: 4px 0;
  }

  /* 🌟 Scoped Links */
  .golf-courses-section .golf-course-link {
    text-decoration: none;
    color: var(--color-text);
    font-size: 16px;
    transition: color 0.2s ease-in-out;
  }
  .golf-courses-section .golf-course-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* 🌟 Responsive Adjustments */
  @media (max-width: 1024px) {
    .golf-courses-section .golf-courses-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .golf-courses-section .golf-courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
