{% schema %}
{
  "name": "USA Golf Courses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "USA Golf Courses (Debug)"
    }
  ]
}
{% endschema %}

<section class="golf-courses-section color-{{ section.settings.color_scheme }}">
  <!-- Debug: Print ALL Course Metaobjects -->
  <h2>Debug: All Courses</h2>
  <p>(Checking which fields actually have data...)</p>
  {% assign all_courses = shop.metaobjects.course.values %}
  {% for c in all_courses %}
    <div style="border:1px solid red; margin:10px; padding:10px; text-align:left;">
      <p><strong>Handle:</strong> {{ c.system.handle }}</p>
      <p><strong>Title (built-in):</strong> {{ c.title }}</p>
      <p><strong>State Field Object:</strong> {{ c.state }}</p>
      {% if c.state %}
        <p><strong>State Value:</strong> [{{ c.state.value }}]</p>
      {% else %}
        <p style="color:red;">No <code>state</code> field or it's empty</p>
      {% endif %}

      <p><strong>Featured Destination:</strong> {{ c.featured_destination }}</p>
    </div>
  {% endfor %}

  <!-- 1) Build a Unique List of States from the courses -->
  {% assign states_csv = '' %}
  {% for c in all_courses %}
    {% if c.state and c.state.value != blank %}
      {% unless states_csv contains c.state.value %}
        {% assign states_csv = states_csv | append: c.state.value | append: ',' %}
      {% endunless %}
    {% endif %}
  {% endfor %}
  {% assign states_array = states_csv | split: ',' | uniq %}

  <!-- 2) Print the States We Found -->
  <div style="border:1px dashed #666; padding:10px; margin-top:20px;">
    <h3>States CSV:</h3>
    <p>{{ states_csv }}</p>
    <h3>States Array:</h3>
    <ul>
      {% for st in states_array %}
        <li>[{{ st }}]</li>
      {% endfor %}
    </ul>
  </div>

  <!-- 3) Group Courses by State -->
  <div class="golf-courses-container">
    <div class="section-header">
      <h2 class="section-title">Golf Courses by State</h2>
    </div>

    <div class="golf-courses-grid">
      {% for st in states_array %}
        {% if st != blank %}
          <div class="golf-course-state">
            <h3>{{ st }}</h3>
            <ul class="courses-list">
              {% for course in all_courses %}
                {% if course.state and course.state.value == st %}
                  <li>
                    <a
                      href="/pages/courses/{{ course.system.handle }}"
                      class="golf-course-link"
                    >
                      <!-- If the built-in title is empty, try course.title.value or some other field -->
                      {{ course.title }}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  /* Just minimal styling so you can see the debug info more clearly. */
  .golf-courses-section {
    padding: 20px;
  }

  .golf-courses-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .golf-course-state {
    border: 1px solid #ccc;
    padding: 10px;
  }
</style>
