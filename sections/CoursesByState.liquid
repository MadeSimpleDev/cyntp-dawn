{% schema %}
{
  "name": "USA Golf Courses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "USA Golf Courses"
    }
  ]
}
{% endschema %}

<section class="golf-courses-section color-{{ section.settings.color_scheme }}">
  <!-- USA Golf Courses by State -->
  <div class="golf-courses-container">
    <div class="section-header">
      <h2 class="section-title">USA Golf Courses by State</h2>
    </div>
    <div class="golf-courses-grid">
      {% for location in shop.metaobjects.location.values %}
        {% assign has_courses = false %}
        {% assign has_trips = false %}

        {% if location.courses and location.courses.size > 0 %}
          {% assign has_courses = true %}
        {% endif %}

        {% if location.trips and location.trips.size > 0 %}
          {% assign has_trips = true %}
        {% endif %}

        {% if has_courses or has_trips %}
          <a href="/pages/locations/{{ location.name | handleize }}" class="golf-course-link">{{ location.name }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- USA Featured Golf Destinations -->
  <div class="golf-courses-container">
    <div class="section-header">
      <h2 class="section-title">USA Featured Golf Destinations</h2>
    </div>
    <div class="golf-courses-grid">
      {% for location in shop.metaobjects.location.values %}
        {% assign has_courses = false %}
        {% assign has_trips = false %}

        {% if location.courses and location.courses.size > 0 %}
          {% assign has_courses = true %}
        {% endif %}

        {% if location.trips and location.trips.size > 0 %}
          {% assign has_trips = true %}
        {% endif %}

        {% if has_courses or has_trips %}
          {% if location.featured_destination == true %}
            <a href="/pages/locations/{{ location.name | handleize }}" class="golf-course-link">{{ location.name }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  /* 🌟 Scoped Section Styling */
  .golf-courses-section {
    text-align: center;
    padding: 40px 20px;
    position: relative;
  }

  /* 🌟 Scoped Container */
  .golf-courses-section .golf-courses-container {
    margin-bottom: 40px;
    position: relative;
  }

  /* 🌟 Scoped Title Wrapper */
  .golf-courses-section .section-header {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    position: relative;
    padding: 10px 0;
  }

  /* 🌟 Scoped Section Titles */
  .golf-courses-section .section-title {
    font-size: 22px;
    font-weight: bold;
    text-transform: uppercase;
    color: #c3996b !important; /* Golden Color */
    position: relative;
    background-color: var(--color-background); /* Ensures text visibility */
    padding: 0 20px;
    z-index: 2;
    white-space: nowrap;
  }

  /* 🌟 Force Title Bars to Show */
  .golf-courses-section .section-header::before,
  .golf-courses-section .section-header::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: #c3996b !important; /* Force Golden Bar */
    display: block;
  }

  /* 🌟 Ensure Bars Extend Fully */
  .golf-courses-section .section-header::before {
    margin-right: 15px;
  }

  .golf-courses-section .section-header::after {
    margin-left: 15px;
  }

  /* 🌟 Scoped Grid Layout */
  .golf-courses-section .golf-courses-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    max-width: 900px;
    margin: 0 auto;
  }

  /* 🌟 Scoped Links */
  .golf-courses-section .golf-course-link {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    font-size: 16px;
    transition: color 0.2s ease-in-out;
  }

  .golf-courses-section .golf-course-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* 🌟 Responsive Adjustments */
  @media (max-width: 1024px) {
    .golf-courses-section .golf-courses-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .golf-courses-section .golf-courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
