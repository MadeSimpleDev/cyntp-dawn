{% comment %}
  Multicolumn + Float with optional Course Articles
  If "Pull from Course Articles" is enabled, we skip the normal blocks and dynamically load articles from a chosen blog
  that match the current course handle (based on article.metafields.custom.course).
{% endcomment %}

{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .multicolumn--with-float.color-{{ section.settings.color_scheme }} {
    position: relative;
  }

  /* ===============================
   * Added heading style
   * =============================== */
  .multicolumn-float__heading-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    position: relative;
    padding: 10px 0;
    margin-bottom: 2rem;
  }

  .multicolumn-float__heading-wrapper::before,
  .multicolumn-float__heading-wrapper::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: #c3996b !important; /* Golden color */
    display: block;
  }

  .multicolumn-float__heading-wrapper::before {
    margin-right: 15px;
  }
  .multicolumn-float__heading-wrapper::after {
    margin-left: 15px;
  }

  .multicolumn-float__heading {
    font-size: 22px;
    font-weight: bold;
    text-transform: uppercase;
    color: #c3996b !important; /* Golden color */
    position: relative;
    background-color: var(--color-background);
    padding: 0 20px;
    z-index: 2;
    white-space: nowrap;
    margin: 0;
  }

  /* ===============================
   * Slider container
   * =============================== */
  .multicolumn-with-float__slider {
    position: relative;
    overflow: hidden;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .multicolumn-with-float__track {
    display: flex;
    gap: 16px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overflow-x: auto;
    white-space: nowrap;
    padding: 1rem 0;
    margin: 0;
    list-style: none;
  }
  .multicolumn-with-float__track::-webkit-scrollbar {
    display: none;
  }
  .multicolumn-with-float__track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Slide */
  .multicolumn-with-float__slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    width: 280px;
    background: var(--color-background);
    position: relative;
    overflow: hidden;
  }

  /* Floating header for images */
  .floating-header {
    position: absolute;
    bottom: 10px;
    left: 10px;
    color: white;
    text-align: left;
    z-index: 2;
    width: 90%;
  }
  .floating-header h2 {
    margin: 0;
    padding: 0;
    font-size: 1.3em;
    font-weight: bold;
    font-style: oblique;
    line-height: 1.2;
  }

  /* Image styling */
  .multicolumn-with-float__image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border);
  }

  /* Slide content */
  .multicolumn-with-float__content {
    padding: 1rem;
  }

  /* Arrows */
  .multicolumn-with-float__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: none;
    border-radius: 50%;
    padding: 0.5rem 1rem;
    cursor: pointer;
    z-index: 10;
    font-size: 1.2rem;
  }
  .multicolumn-with-float__arrow--prev {
    left: 0.5rem;
  }
  .multicolumn-with-float__arrow--next {
    right: 0.5rem;
  }
{%- endstyle -%}

{%- liquid
  assign show_mobile_slider = section.settings.swipe_on_mobile
  assign show_desktop_slider = section.settings.enable_desktop_slider
-%}

<div
  class="multicolumn--with-float color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  {%- unless section.settings.title == blank -%}
    <div class="multicolumn-float__heading-wrapper">
      <h2 class="multicolumn-float__heading {{ section.settings.heading_size }}">
        {{ section.settings.title }}
      </h2>
    </div>
  {%- endunless -%}

  <div class="multicolumn-with-float__slider" id="MultiFloatSlider-{{ section.id }}">
    <!-- Prev Arrow -->
    <button
      class="multicolumn-with-float__arrow multicolumn-with-float__arrow--prev"
      type="button"
      aria-label="Previous"
    >
      &laquo;
    </button>

    <!-- Slides Track -->
    <ul class="multicolumn-with-float__track" id="Track-{{ section.id }}">
      {%- comment %}
        1) If user toggled "Pull from course articles", then skip normal blocks
        2) Otherwise, show the default column blocks
      {%- endcomment %}

      {% if section.settings.enable_course_articles == true and section.settings.articles_blog != blank %}
        {%- comment %}
          Grab current course handle from URL
        {%- endcomment %}
        {%- assign course_handle = request.path | split: '/' | last -%}

        {%- comment %}
          Loop through the chosen blog's articles, up to "articles_limit"
        {%- endcomment %}
        {%- for article in section.settings.articles_blog.articles limit: section.settings.articles_limit -%}
          {%- assign article_course = article.metafields.custom.course.value -%}
          {%- assign article_course_handle = article_course.name | handleize -%}

          {%- if article_course_handle == course_handle -%}
            <li class="multicolumn-with-float__slide">
              <div style="position: relative; overflow: hidden;">
                {%- if article.image -%}
                  <img
                    src="{{ article.image.src | image_url: width: 600 }}"
                    alt="{{ article.title | escape }}"
                    class="multicolumn-with-float__image"
                  >
                {%- endif -%}
              </div>
              <div class="multicolumn-with-float__content">
                <h3>{{ article.title | escape }}</h3>
                {%- if article.excerpt.size > 0 -%}
                  <p>{{ article.excerpt | strip_html | truncatewords: 25 }}</p>
                {%- endif -%}

                <a href="{{ article.url }}" class="link animate-arrow">Read more</a>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {% else %}
        {%- comment %}
          Normal blocks approach
        {%- endcomment %}
        {%- for block in section.blocks -%}
          <li
            class="multicolumn-with-float__slide"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              <div style="position: relative; overflow: hidden;">
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt=""
                  class="multicolumn-with-float__image"
                >
                {% if block.settings.floating_header != blank %}
                  <div class="floating-header">
                    <h2>{{ block.settings.floating_header }}</h2>
                  </div>
                {% endif %}
              </div>
            {% endif %}
            <div class="multicolumn-with-float__content">
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.link_label != blank %}
                <a href="{{ block.settings.link }}" class="link animate-arrow">
                  {{ block.settings.link_label }}
                </a>
              {% endif %}
            </div>
          </li>
        {%- endfor -%}
      {% endif %}
    </ul>

    <!-- Next Arrow -->
    <button
      class="multicolumn-with-float__arrow multicolumn-with-float__arrow--next"
      type="button"
      aria-label="Next"
    >
      &raquo;
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sectionId = '{{ section.id }}';
    var slider = document.getElementById('MultiFloatSlider-' + sectionId);
    if (!slider) return;

    var track = document.getElementById('Track-' + sectionId);
    var btnPrev = slider.querySelector('.multicolumn-with-float__arrow--prev');
    var btnNext = slider.querySelector('.multicolumn-with-float__arrow--next');

    var scrollAmount = 300; // distance to scroll per click

    btnPrev.addEventListener('click', function () {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', function () {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  });
</script>

{% schema %}
{
  "name": "Multicolumn+Float",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "default": false,
      "label": "Enable horizontal scroll on desktop"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "Enable swipe on mobile"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Multicolumn Floats",
      "label": "Section Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Regular Heading (H2)"
        },
        {
          "value": "h1",
          "label": "Large Heading (H1)"
        },
        {
          "value": "h3",
          "label": "Medium Heading (H3)"
        }
      ],
      "default": "h2",
      "label": "Heading Size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    },

    {
      "type": "header",
      "content": "Pull Articles for Current Course"
    },
    {
      "type": "checkbox",
      "id": "enable_course_articles",
      "default": false,
      "label": "Pull from course articles?"
    },
    {
      "type": "blog",
      "id": "articles_blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of articles to display"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "floating_header",
          "label": "Floating Header",
          "default": "Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn + Float Scroll",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
