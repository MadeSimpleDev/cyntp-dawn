{%- comment -%}
  Multicolumn + Float
  Allows a horizontal scroll (slider) for each column block, with optional floating headers.
  Can also pull blog articles based on a "course" metafield reference, displaying the article date above the floating title,
  and clamping the title to 2 lines.
{%- endcomment -%}

{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .multicolumn--with-float.color-{{ section.settings.color_scheme }} {
    position: relative;
  }

  /* ====== Heading Style ====== */
  .multicolumn-float__heading-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    position: relative;
    padding: 10px 0;
    margin-bottom: 2rem;
  }
  .multicolumn-float__heading-wrapper::before,
  .multicolumn-float__heading-wrapper::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: #c3996b !important; /* Golden color */
    display: block;
  }
  .multicolumn-float__heading-wrapper::before {
    margin-right: 15px;
  }
  .multicolumn-float__heading-wrapper::after {
    margin-left: 15px;
  }
  .multicolumn-float__heading {
    font-size: 22px;
    font-weight: bold;
    text-transform: uppercase;
    color: #c3996b !important; /* Golden color */
    position: relative;
    background-color: var(--color-background);
    padding: 0 20px;
    z-index: 2;
    white-space: nowrap;
    margin: 0;
  }

  /* ====== Slider Container ====== */
  .multicolumn-with-float__slider {
    position: relative;
    overflow: hidden;
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .multicolumn-with-float__track {
    display: flex;
    gap: 16px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overflow-x: auto;
    white-space: nowrap;
    padding: 1rem 0;
    margin: 0;
    list-style: none;
  }
  .multicolumn-with-float__track::-webkit-scrollbar {
    display: none;
  }
  .multicolumn-with-float__track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Each Slide */
  .multicolumn-with-float__slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    width: 280px;
    background: var(--color-background);
    position: relative;
    overflow: hidden;
  }

  /* Floating header for images */
  .floating-header {
    position: absolute;
    bottom: 10px;
    left: 10px;
    z-index: 2;
    width: 90%;
    color: #fff;
    text-align: left;
  }

  /* Article date above the title */
  .floating-header .floating-date {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 4px;
    display: inline-block;
  }

  /* Title: clamp to 2 lines */
  .floating-header h2 {
    margin: 0;
    padding: 0;
    font-size: 1.3em;
    font-weight: bold;
    font-style: oblique;
    line-height: 1.2;

    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Image styling */
  .multicolumn-with-float__image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border);
  }

  /* Arrows */
  .multicolumn-with-float__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    border-radius: 50%;
    padding: 0.5rem;
    cursor: pointer;
    z-index: 10;
    font-size: 1.2rem;
    display: none; /* Hide by default, shown via JS */
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
  }
  .multicolumn-with-float__arrow svg {
    width: 20px;
    height: 20px;
  }
  .multicolumn-with-float__arrow--prev {
    left: 0.5rem;
  }
  .multicolumn-with-float__arrow--next {
    right: 0.5rem;
  }

  /* Slide content */
  .multicolumn-with-float__content {
    padding: 1rem;
  }

  /* New styles for the card link wrapper */
  .multicolumn-with-float__card-link {
    display: block; /* Make the link a block element */
    color: inherit; /* Inherit text color from parent */
    text-decoration: none; /* Remove default underline */
    position: relative; /* Needed for potential absolute positioning inside */
    height: 100%; /* Ensure it fills the list item */
    border-radius: inherit; /* Inherit border radius from parent li */
    overflow: hidden; /* Ensure content respects border radius */
  }
  .multicolumn-with-float__card-link:hover {
    text-decoration: none; /* Ensure no underline on hover */
    color: inherit;
  }
  .multicolumn-with-float__card-link:focus-visible {
    outline: 2px solid var(--color-foreground); /* Add focus outline */
    outline-offset: 2px;
    box-shadow: 0 0 0 3px var(--color-background), 0 0 0 5px var(--color-foreground);
  }
{%- endstyle -%}

{%- liquid
  assign show_mobile_slider = section.settings.swipe_on_mobile
  assign show_desktop_slider = section.settings.enable_desktop_slider
-%}

<div
  class="multicolumn--with-float color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  {%- unless section.settings.title == blank -%}
    <div class="multicolumn-float__heading-wrapper">
      <h2 class="multicolumn-float__heading {{ section.settings.heading_size }}">
        {{ section.settings.title }}
      </h2>
    </div>
  {%- endunless -%}

  <div class="multicolumn-with-float__slider" id="MultiFloatSlider-{{ section.id }}">
    <!-- Arrow Prev -->
    <button
      class="multicolumn-with-float__arrow multicolumn-with-float__arrow--prev"
      type="button"
      aria-label="Previous"
    >
      <!-- Left Chevron SVG -->
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M15.5 3.87a1 1 0 0 1 1.39 1.44L10.41 12l6.48 6.69a1 1 0 0 1-1.44 1.38l-7.18-7.42a1 1 0 0 1 0-1.38z"
          fill="currentColor"
        />
      </svg>
    </button>

    <!-- Track -->
    <ul class="multicolumn-with-float__track" id="Track-{{ section.id }}">
      {% comment %}
        If "enable_course_articles" is TRUE, skip normal blocks and show articles that match the current course.
        We'll show the date above the floating title, and clamp the title to 2 lines.
      {% endcomment %}
      {% if section.settings.enable_course_articles == true and section.settings.articles_blog != blank %}
        {%- assign course_handle = request.path | split: '/' | last -%}
        {%- for article in section.settings.articles_blog.articles limit: section.settings.articles_limit -%}
          {%- assign article_course = article.metafields.custom.course.value -%}
          {%- assign article_course_handle = article_course.name | handleize -%}
          {%- if article_course_handle == course_handle -%}
            <li class="multicolumn-with-float__slide">
              <!-- Entire card is clickable -->
              <a href="{{ article.url }}" style="display: block; position: relative; overflow: hidden;">
                {% if article.image %}
                  <img
                    src="{{ article.image.src | image_url: width: 600 }}"
                    alt="{{ article.title | escape }}"
                    class="multicolumn-with-float__image"
                  >
                {% endif %}
                <!-- Floating text area: date above the 2-line title -->
                <div class="floating-header">
                  <p class="floating-date">
                    {{ article.published_at | time_tag: format: 'date' }}
                  </p>
                  <h2>{{ article.title | escape }}</h2>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {% else %}
        {%- comment %} Normal multi-column block approach {%- endcomment %}
        {%- for block in section.blocks -%}
          <li class="multicolumn-with-float__slide" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="multicolumn-with-float__card-link">
            {%- endif -%}

            {% if block.settings.image != blank %}
              <div style="position: relative; overflow: hidden;">
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.floating_header | default: block.settings.title | escape }}"
                  class="multicolumn-with-float__image"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
                {% if block.settings.floating_header != blank %}
                  <div class="floating-header">
                    <h2>{{ block.settings.floating_header }}</h2>
                  </div>
                {% endif %}
              </div>
            {% endif %}
            <div class="multicolumn-with-float__content">
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
              {%- comment %} Change link to span if the whole card is a link {% endcomment -%}
              {% if block.settings.link_label != blank %}
                {%- if block.settings.link != blank -%}
                  <span class="link animate-arrow">
                    {{ block.settings.link_label }}
                  </span>
                {%- else -%}
                  {%- comment %} If no card link, but label exists, render as plain text or maybe nothing? Let's render nothing for now. {% endcomment -%}
                  {%- comment -%} <p>{{ block.settings.link_label }}</p> {%- endcomment -%}
                {%- endif -%}
              {% endif %}
            </div>

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {% endif %}
    </ul>

    <!-- Arrow Next -->
    <button
      class="multicolumn-with-float__arrow multicolumn-with-float__arrow--next"
      type="button"
      aria-label="Next"
    >
      <!-- Right Chevron SVG -->
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M8.5 20.13a1 1 0 0 1-1.39-1.44L13.59 12l-6.48-6.69A1 1 0 0 1 8.55 3.93l7.18 7.42a1 1 0 0 1 0 1.38z"
          fill="currentColor"
        />
      </svg>
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sectionId = '{{ section.id }}';
    var slider = document.getElementById('MultiFloatSlider-' + sectionId);
    if (!slider) return;

    var track = document.getElementById('Track-' + sectionId);
    var btnPrev = slider.querySelector('.multicolumn-with-float__arrow--prev');
    var btnNext = slider.querySelector('.multicolumn-with-float__arrow--next');

    var scrollAmount = 300; // distance to scroll per click

    // Scroll by +/-300px on click
    btnPrev.addEventListener('click', function () {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    btnNext.addEventListener('click', function () {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    // Show/hide arrows based on scroll position & overflow
    function updateArrowsVisibility() {
      var maxScrollLeft = track.scrollWidth - track.clientWidth;

      // If there's no overflow, hide both
      if (maxScrollLeft <= 0) {
        btnPrev.style.display = 'none';
        btnNext.style.display = 'none';
        return;
      }

      // Check if we can scroll to the left
      if (track.scrollLeft > 0) {
        btnPrev.style.display = 'flex';
      } else {
        btnPrev.style.display = 'none';
      }

      // Check if we can scroll to the right
      if (track.scrollLeft < maxScrollLeft) {
        btnNext.style.display = 'flex';
      } else {
        btnNext.style.display = 'none';
      }
    }

    // Listen to scroll + resize
    track.addEventListener('scroll', updateArrowsVisibility);
    window.addEventListener('resize', updateArrowsVisibility);

    // Initial check once images load
    var imgs = slider.querySelectorAll('img');
    var imgCount = imgs.length;
    var loadedCount = 0;

    function imgLoaded() {
      loadedCount++;
      if (loadedCount === imgCount) {
        updateArrowsVisibility();
      }
    }
    imgs.forEach(function (img) {
      if (img.complete) {
        imgLoaded();
      } else {
        img.addEventListener('load', imgLoaded);
        img.addEventListener('error', imgLoaded);
      }
    });

    // If no images or everything loads instantly, fallback:
    if (imgCount === 0) {
      updateArrowsVisibility();
    }
  });
</script>

{% schema %}
{
  "name": "Multicolumn+Float",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "default": false,
      "label": "Enable horizontal scroll on desktop"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "Enable swipe on mobile"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Multicolumn Floats",
      "label": "Section Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Regular Heading (H2)"
        },
        {
          "value": "h1",
          "label": "Large Heading (H1)"
        },
        {
          "value": "h3",
          "label": "Medium Heading (H3)"
        }
      ],
      "default": "h2",
      "label": "Heading Size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Pull Articles for Current Course"
    },
    {
      "type": "checkbox",
      "id": "enable_course_articles",
      "default": false,
      "label": "Pull from course articles?"
    },
    {
      "type": "blog",
      "id": "articles_blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of articles to display"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "floating_header",
          "label": "Floating Header",
          "default": "Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "info": "If a Link URL is provided, this text will appear but the entire card will be clickable."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL",
          "info": "If provided, the entire card will link to this URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn + Float Scroll",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}