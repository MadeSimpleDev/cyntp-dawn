{%- paginate blog.articles by 10 -%}
  {% assign articles = paginate.items %}
  {% assign first_article = articles | first %}

  {% if blog.articles_count == 0 %}
    <p>No articles found in {{ blog.handle }}.</p>
  {% else %}
    <!-- Hero (article #1) -->
    {% if first_article %}
      <div class="hero-article">
        <!-- your hero code -->
      </div>
    {% endif %}

    <!-- Next articles in groups of 5 -->
    {% for article in articles offset: 1 %}
      {% assign index_in_group = forloop.index0 | modulo: 5 %}
      {% if index_in_group < 4 %}
        <!-- Small post (4 in each group) -->
      {% else %}
        <!-- Big post (the 5th in each group) -->
      {% endif %}
    {% endfor %}
  {% endif %}
{%- endpaginate %}
