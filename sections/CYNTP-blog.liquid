{%- comment -%}
  Hero / 4 Small / 1 Big pattern
  + "Load More" button for the leftover groups
  + Entire card is clickable, not just the title
  + No Liquid paginate
{%- endcomment -%}

<!--
  Liquid steps:
  1) Gather all articles: blog.articles
  2) The first is hero.
  3) The rest are chunked in sets of 5:
     - first 4 => "small-post"
     - 5th => "big-post"
  4) We initially show only the FIRST group of leftover articles, plus the hero.
  5) A "Load More" button in JS reveals each next group if any.
-->

{% assign all_articles = blog.articles %}
{% assign first_article = all_articles | first %}

<!-- Debug area (optional) -->
<div style="background:#f9f0c7; padding:10px; margin-bottom:1rem; border:1px solid #ccc;">
  <strong>Debug Info:</strong><br>
  blog.handle: {{ blog.handle -}}
  <br>
  blog.articles_count: {{ blog.articles_count -}}
  <br>
  all_articles.size: {{ all_articles.size -}}
  <br>
  {% if first_article %}
    first_article.title: {{ first_article.title -}}
    <br>
  {% else %}
    No first_article found
  {% endif %}
</div>

<!-- If no articles exist, we just say so. -->
{% if all_articles.size == 0 %}
  <p>No articles found.</p>
{% else %}
  <!--
    =========================
    1) HERO ARTICLE
    =========================
  -->
  {% if first_article %}
    <div class="hero-article">
      <!-- Entire hero card is clickable -->
      <a href="{{ first_article.url }}" class="hero-article__link">
        {% if first_article.image %}
          <img
            class="hero-article__image"
            src="{{ first_article.image.src | image_url: width: 1600 }}"
            alt="{{ first_article.image.src.alt | escape }}"
          >
        {% endif %}
        <div class="hero-article__overlay">
          <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
          <p class="hero-article__meta">
            {{ first_article.published_at | time_tag: format: 'date' }}
            {% if first_article.author %} | By {{ first_article.author }}{% endif %}
          </p>
          {% if first_article.excerpt %}
            <p class="hero-article__excerpt">{{ first_article.excerpt | strip_html | truncatewords: 30 }}</p>
          {% endif %}
        </div>
      </a>
    </div>
  {% endif %}

  <!--
    =========================
    2) LEFTOVER ARTICLES
      in sets of 5
    =========================
  -->
  {% assign leftover_articles = all_articles | slice: 1, all_articles.size | default: 0 %}
  <!-- slice(1..) means skip first, i.e. leftover -->

  {% if leftover_articles.size > 0 %}
    <!-- We'll build groups (array-of-arrays) in Liquid. Each sub-array is up to 5 articles. -->
    {% assign groups = '' | split: ',' %} {# an empty array #}
    {% for i in (0..ceiling(leftover_articles.size/5) - 1) %}
      {% capture groupSlice %}
        {{ leftover_articles | slice: i*5, 5 | json }}
      {% endcapture %}
      {% assign groups = groups | push: groupSlice %}
    {% endfor %}

    <!-- Render the FIRST group by default. Keep the rest hidden until "Load More" is clicked. -->
    <div id="LeftoverArticleContainer" class="leftover-articles-container">
      <!-- We will fill this with the first group via JavaScript, and any subsequent groups on "Load More" -->
    </div>

    {% if groups.size > 1 %}
      <!-- If there's more than 1 leftover group, show the "Load More" button. -->
      <div class="load-more-wrapper center">
        <button id="LoadMoreBtn" class="load-more-button">Load more posts</button>
      </div>
    {% endif %}

    <!-- We'll embed the leftover groups as JSON to parse in JS. -->
    <script type="application/json" id="LeftoverGroupsData">
      {{ groups | json }}
    </script>

    <script>
    (function(){
      // We'll chunk leftover articles in "groups" each up to 5 items
      // 'LeftoverGroupsData' is an array of JSON-strings, each representing up to 5 articles.

      var groupsDataEl = document.getElementById('LeftoverGroupsData');
      if(!groupsDataEl) return;

      var leftoverGroups = JSON.parse(groupsDataEl.textContent); // array of stringified article-lists
      // leftoverGroups[i] is a JSON string of up to 5 article objects
      // e.g. "[ {id:...,title:...}, ... ]"

      // We'll track which group index we last displayed
      var currentIndex = 0;
      var containerEl = document.getElementById('LeftoverArticleContainer');
      var loadMoreBtn = document.getElementById('LoadMoreBtn');

      // Function to render a single group
      function renderGroup(groupJson) {
        var groupArticles = JSON.parse(groupJson); 
        // For each article in groupArticles:
        //   - 0..3 => "small-post"
        //   - 4 => "big-post"
        // We'll produce HTML and append.

        var groupHTML = '';
        for(var i=0; i<groupArticles.length; i++){
          var art = groupArticles[i];
          var indexInGroup = i; // 0..4
          // entire card clickable
          var cardClass = (indexInGroup < 4) ? 'small-post' : 'big-post';
          var widthVal  = (indexInGroup < 4) ? 500 : 1200; // small vs big width

          // Build a block
          var postHTML = `
            <a class="${cardClass} clickable-card" href="${art.url}">
              ${
                art.image
                  ? `<div class="${cardClass}__image-wrap">
                      <img class="${cardClass}__image" 
                           src="${art.image.src | replace: '"', '%22'}?width=${widthVal}"
                           alt="${ art.image.alt ? art.image.alt : '' }" />
                    </div>`
                  : ''
              }
              <div class="${cardClass}__content">
                <h3 class="${cardClass}__title" style="margin:0 0 .3rem; font-size: 1.25rem; font-weight: bold;">
                  ${art.title}
                </h3>
                <p class="${cardClass}__meta" style="font-size:.875rem; opacity:.8; margin-bottom:.5rem;">
                  ${art.published_at}
                  ${
                    art.author 
                      ? ' | By ' + art.author
                      : ''
                  }
                </p>
                ${
                  art.summary_html
                  ? `<p class="${cardClass}__excerpt" style="font-size:.9rem; line-height:1.4;">
                      ${art.summary_html}
                     </p>`
                  : ''
                }
              </div>
            </a>
          `;
          groupHTML += postHTML;
        }
        // Append to container
        var wrapper = document.createElement('div');
        wrapper.innerHTML = groupHTML;
        containerEl.appendChild(wrapper);
      }

      // Render the 1st group immediately
      if(leftoverGroups.length > 0){
        renderGroup(leftoverGroups[currentIndex]);
      }

      // "Load More" button
      if(loadMoreBtn){
        // If there's only 1 leftover group, hide the button
        if(leftoverGroups.length <= 1){
          loadMoreBtn.style.display = 'none';
        }

        loadMoreBtn.addEventListener('click', function(){
          currentIndex++;
          if(currentIndex < leftoverGroups.length){
            renderGroup(leftoverGroups[currentIndex]);
          }
          if(currentIndex >= leftoverGroups.length -1){
            // no more groups left
            loadMoreBtn.style.display = 'none';
          }
        });
      }
    })();
    </script>
  {% endif %}
{% endif %}

<!--
  =========================
  CSS
  =========================
-->
<style>
  /* 
  1) Large (Hero) Image 
     - Title: white, bold, italic
     - Desktop: text on left w/ black overlay
     - Mobile: text at bottom, tall image
*/

  /* Hero container & image link for the entire clickable area */
  .hero-article {
    position: relative;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .hero-article__link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* Make the hero image "taller" in general. 
   We'll use min-height in a ratio approach or fixed viewport approach. 
   This is one approach; tweak as needed. */
  .hero-article__image {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  /* The overlay with text. We'll handle desktop vs mobile in media queries. */
  .hero-article__overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: rgba(0, 0, 0, 0); /* We'll set different background in desktop. */
  }

  /* White, bold, italic for hero title. */
  .hero-article__title {
    margin: 0 0 0.5rem;
    color: #fff;
    font-weight: bold;
    font-style: italic;
    font-size: 2rem;
    line-height: 1.1;
  }

  /* 
  2) Desktop vs Mobile 
*/
  @media screen and (min-width: 750px) {
    /* Desktop: 
     - text on left side 
     - partial black background 
  */
    .hero-article__overlay {
      align-items: flex-start;
      width: 40%;
      background: rgba(0, 0, 0, 0.4); /* Transparent black for contrast */
    }
  }
  @media screen and (max-width: 749px) {
    /* Mobile: 
     - text at bottom
     - image is taller 
     - overlay covers bottom 
  */
    .hero-article__image {
      min-height: 60vh; /* make it taller on mobile */
    }
    .hero-article__overlay {
      justify-content: flex-end;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
      padding-bottom: 2rem;
    }
  }

  /*
  3) Entire Card Clickable For All "Small" or "Big" Posts
     We'll unify them as .clickable-card
*/
  .clickable-card {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .clickable-card:hover {
    transform: scale(1.01);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
  }

  /* 
  4) small-post style 
     Titles are standard <h3>, no anchor 
*/
  .small-post {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    background: #fff;
    border: 1px solid #ddd;
    padding: 1rem;
  }
  .small-post__image-wrap {
    flex: 0 0 200px;
    overflow: hidden;
  }
  .small-post__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .small-post__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .small-post__title {
    font-size: 1.25rem;
    font-weight: bold;
    margin-bottom: 0.3rem;
  }
  /* If you want italic or bold styling, you can add it here. */

  .big-post {
    margin-bottom: 2rem;
    background: #fff;
    border: 1px solid #ddd;
    padding: 1rem;
  }
  .big-post__image-wrap {
    margin-bottom: 0.5rem;
    overflow: hidden;
  }
  .big-post__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .big-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
    font-weight: bold;
  }

  /* 
  5) "Load More" button styling
*/
  .load-more-wrapper {
    margin-top: 2rem;
  }
  .load-more-button {
    padding: 0.75rem 1.5rem;
    background: #333;
    color: #fff;
    border: none;
    cursor: pointer;
    border-radius: 4px;
  }
  .load-more-button:hover {
    opacity: 0.9;
  }
</style>
