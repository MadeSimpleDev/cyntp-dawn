{%- comment -%}
  Placeholder Hero / Big / Small Pattern
  WITHOUT article images
  - First article => "Hero"
  - Remainder => Groups of 5:
      => 4 "small-post"
      => 1 "big-post"
  - Paginate by 10
{%- endcomment -%}

{%- paginate blog.articles by 10 -%}
  {% assign articles = paginate.items %}
  {% assign first_article = articles | first %}

  {% if articles.size == 0 %}
    <p>No articles found in this pagination slice.</p>
  {% else %}
    <!-- Hero: The very first article only -->
    {% if first_article %}
      <div class="hero-article-placeholder">
        <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
        <p class="hero-article__meta">
          {{ first_article.published_at | time_tag: format: 'date' }}
          {% if first_article.author %} | By {{ first_article.author }}{% endif %}
        </p>
        {% if first_article.excerpt %}
          <p class="hero-article__excerpt">{{ first_article.excerpt | strip_html | truncatewords: 30 }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Loop leftover articles, in sets of 5 -->
    {% for article in articles offset: 1 %}
      {% assign index_in_group = forloop.index0 | modulo: 5 %}

      {% if index_in_group < 4 %}
        <!-- SMALL-POST (the first 4 in each set of 5) -->
        <div class="small-post-placeholder">
          <h3 class="small-post__title">{{ article.title | escape }}</h3>
          <p class="small-post__meta">
            {{ article.published_at | time_tag: format: 'date' }}
            {% if article.author %} | By {{ article.author }}{% endif %}
          </p>
          {% if article.excerpt %}
            <p class="small-post__excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
          {% endif %}
        </div>

      {% else %}
        <!-- BIG-POST (the 5th leftover in each group) -->
        <div class="big-post-placeholder">
          <h3 class="big-post__title">{{ article.title | escape }}</h3>
          <p class="big-post__meta">
            {{ article.published_at | time_tag: format: 'date' }}
            {% if article.author %} | By {{ article.author }}{% endif %}
          </p>
          {% if article.excerpt %}
            <p class="big-post__excerpt">{{ article.excerpt | strip_html | truncatewords: 25 }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    <!-- PAGINATION if more than 1 page -->
    {% if paginate.pages > 1 %}
      <div class="pagination">
        {%- render 'pagination', paginate: paginate -%}
      </div>
    {% endif %}
  {% endif %}
{%- endpaginate %}

<style>
  /* Simple placeholders to confirm each block is rendered */

  .hero-article-placeholder {
    background: #ffd5d5;
    padding: 1rem;
    margin-bottom: 2rem;
  }
  .hero-article__title {
    margin: 0 0 0.5rem;
    font-size: 1.8rem;
    font-weight: bold;
  }
  .hero-article__meta {
    font-size: 0.9rem;
    color: #333;
    margin-bottom: 0.4rem;
  }

  .small-post-placeholder {
    background: #d5ffd5;
    padding: 1rem;
    margin-bottom: 1rem;
  }
  .small-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.2rem;
    font-weight: bold;
  }
  .small-post__meta {
    font-size: 0.8rem;
    color: #333;
    margin-bottom: 0.4rem;
  }

  .big-post-placeholder {
    background: #d5f1ff;
    padding: 1rem;
    margin-bottom: 1rem;
  }
  .big-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
    font-weight: bold;
  }
  .big-post__meta {
    font-size: 0.85rem;
    color: #333;
    margin-bottom: 0.4rem;
  }

  .pagination {
    margin-top: 2rem;
    text-align: center;
  }
</style>
