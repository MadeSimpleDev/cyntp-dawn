{% comment %}
  Custom Blog Pattern Section
  ---------------------------
  - Shows first article as a large 'hero' with overlay text.
  - Then loops the remaining articles in sets of 5:
    * The first 4 are "small" style (image left, text right).
    * The 5th is "big" style (large image, text below).
  - Repeats until all articles are shown.
  - Includes basic pagination.

  Usage:
  1. Create or upload "blog-custom-pattern.liquid" to "sections/".
  2. Create a new template under "templates/blog.custom-pattern.json" that references this section.
  3. Assign this template to your desired Blog in Shopify admin.

  NOTE: Adjust styling & classes below to match your theme’s look and feel.
{% endcomment %}

{%- paginate blog.articles by 10 -%}
  {# Adjust items per page as desired #}
  <div class="blog-custom-pattern">
    <!-- If there are no articles, display a message. Otherwise, show the pattern. -->
    {% if blog.articles.size == 0 %}
      <p>No articles found.</p>
    {% else %}
      {%- assign articles = paginate.items -%}
      {%- assign first_article = articles | first -%}

      <!-- ========== 1) HERO ARTICLE ========== -->
      {% if first_article %}
        <div class="hero-article">
          <a href="{{ first_article.url }}" class="hero-article__image-link">
            {% if first_article.image %}
              <img
                class="hero-article__image"
                src="{{ first_article.image.src | image_url: width: 1600 }}"
                alt="{{ first_article.image.src.alt | escape }}"
              >
            {% endif %}
            <div class="hero-article__overlay">
              <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
              <p class="hero-article__meta">
                {{ first_article.published_at | time_tag: format: 'date' }}
                {% if first_article.author %} &nbsp;|&nbsp; By {{ first_article.author }}{% endif %}
              </p>
              {% if first_article.excerpt %}
                <p class="hero-article__excerpt">{{ first_article.excerpt | strip_html | truncatewords: 30 }}</p>
              {% endif %}
            </div>
          </a>
        </div>
      {% endif %}

      <!-- ========== 2) REMAINING ARTICLES IN PATTERN ========== -->
      {%- for article in articles limit: articles.size %}
        {% unless forloop.first %}
          {% comment %}
            We skip the very first item (the hero).
            Then we group the rest in sets of 5:
              indexes:
                patternIndex = (forloop.index - 2) % 5
                0..3 => "small"
                4    => "big"
          {% endcomment %}
          {%- assign patternIndex = forloop.index | minus: 2 | modulo: 5 -%}

          {% if patternIndex <= 3 %}
            <!-- Small post: image on left, text on right -->
            <div class="small-post">
              <div class="small-post__image-wrap">
                {% if article.image %}
                  <a href="{{ article.url }}">
                    <img
                      class="small-post__image"
                      src="{{ article.image.src | image_url: width: 500 }}"
                      alt="{{ article.image.src.alt | escape }}"
                    >
                  </a>
                {% endif %}
              </div>
              <div class="small-post__content">
                <h3 class="small-post__title">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>
                <p class="small-post__meta">
                  {{ article.published_at | time_tag: format: 'date' }}
                  {% if article.author %} &nbsp;|&nbsp; By {{ article.author }}{% endif %}
                </p>
                {% if article.excerpt %}
                  <p class="small-post__excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
                {% endif %}
              </div>
            </div>
          {% else %}
            <!-- Big post: large image, text below -->
            <div class="big-post">
              <div class="big-post__image-wrap">
                {% if article.image %}
                  <a href="{{ article.url }}">
                    <img
                      class="big-post__image"
                      src="{{ article.image.src | image_url: width: 1200 }}"
                      alt="{{ article.image.src.alt | escape }}"
                    >
                  </a>
                {% endif %}
              </div>
              <div class="big-post__content">
                <h3 class="big-post__title">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>
                <p class="big-post__meta">
                  {{ article.published_at | time_tag: format: 'date' }}
                  {% if article.author %} &nbsp;|&nbsp; By {{ article.author }}{% endif %}
                </p>
                {% if article.excerpt %}
                  <p class="big-post__excerpt">{{ article.excerpt | strip_html | truncatewords: 25 }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endunless %}
      {%- endfor %}

      <!-- ========== PAGINATION ========== -->
      {% if paginate.pages > 1 %}
        <div class="pagination">
          {%- render 'pagination', paginate: paginate -%}
        </div>
      {% endif %}
    {% endif %}
  </div>
{%- endpaginate %}

<style>
  /* ====== Hero Article Styles ====== */
  .hero-article {
    position: relative;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .hero-article__image-link {
    display: inline-block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .hero-article__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .hero-article__overlay {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 1.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    color: #fff;
  }
  .hero-article__title {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    line-height: 1.1;
  }
  .hero-article__meta {
    font-size: 0.875rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }
  .hero-article__excerpt {
    font-size: 1rem;
    line-height: 1.4;
  }

  /* ====== Small Post Styles ====== */
  .small-post {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .small-post__image-wrap {
    flex: 0 0 200px;
    overflow: hidden;
  }
  .small-post__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .small-post__content {
    flex: 1;
  }
  .small-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.25rem;
  }
  .small-post__title a {
    text-decoration: none;
    color: inherit;
  }
  .small-post__meta {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }
  .small-post__excerpt {
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* ====== Big Post Styles ====== */
  .big-post {
    margin-bottom: 2rem;
  }
  .big-post__image-wrap {
    margin-bottom: 0.5rem;
  }
  .big-post__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .big-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
  }
  .big-post__title a {
    text-decoration: none;
    color: inherit;
  }
  .big-post__meta {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }
  .big-post__excerpt {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  /* ====== Pagination ====== */
  .pagination {
    margin-top: 2rem;
    text-align: center;
  }
</style>
