{%- comment -%}
  CYNTP Blog Pattern (Debug Mode):
  - First article => hero style
  - Next articles => groups of 5
    => 4 small-post items
    => 1 big-post item
  - Paginate by 10 articles
  - Prints debug info for each article
{%- endcomment -%}

{%- paginate blog.articles by 10 -%}
  <!-- Basic debug info about the blog -->
  <div style="background:#f9f0c7; padding:10px; margin-bottom:1rem; border:1px solid #ccc; color:#333;">
    <strong>Debug Info</strong>
    <p>
      Blog handle: <strong>{{ blog.handle }}</strong>
    </p>
    <p>
      blog.articles_count: <strong>{{ blog.articles_count }}</strong>
    </p>
    <p>
      paginate.items.size: <strong>{{ paginate.items.size }}</strong>
    </p>
  </div>

  <div class="blog-custom-pattern">
    {%- if blog.articles.size == 0 -%}
      <p>No articles found for this blog.</p>
    {%- else -%}
      {%- assign articles = paginate.items -%}
      {%- assign first_article = articles | first -%}

      <!-- ========== 1) HERO ARTICLE ========== -->
      {% if first_article %}
        <div style="background:#eef; padding:10px; margin-bottom:1rem;">
          <p style="margin:0;">
            <strong>Hero Article Debug:</strong> {{ first_article.title }} | {{ first_article.id }}
          </p>
        </div>
        <div class="hero-article">
          <a href="{{ first_article.url }}" class="hero-article__image-link">
            {% if first_article.image %}
              <img
                class="hero-article__image"
                src="{{ first_article.image.src | image_url: width: 1600 }}"
                alt="{{ first_article.image.src.alt | escape }}"
              >
            {% endif %}
            <div class="hero-article__overlay">
              <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
              <p class="hero-article__meta">
                {{ first_article.published_at | time_tag: format: 'date' }}
                {% if first_article.author %} &nbsp;|&nbsp; By {{ first_article.author }}{% endif %}
              </p>
              {% if first_article.excerpt %}
                <p class="hero-article__excerpt">{{ first_article.excerpt | strip_html | truncatewords: 30 }}</p>
              {% endif %}
            </div>
          </a>
        </div>
      {% endif %}

      <!-- ========== 2) REMAINING ARTICLES ========== -->
      {% comment %}
        We'll iterate over all articles except the first.
        index_in_group => forloop.index0 modulo 5
          => 0..3 => small-post
          => 4 => big-post
      {% endcomment %}
      {% for article in articles offset: 1 %}
        <!-- Debug block for each article -->
        <div style="background:#ffe; padding:10px; margin-bottom:.5rem; border:1px dashed #ccc;">
          <strong>Article Debug:</strong>
          <p style="margin:0;">
            Title: {{ article.title }}
            <br>
            Author: {{ article.author }}
            <br>
            ID: {{ article.id }}
            <br>
            Published: {{ article.published_at | time_tag: format: 'date' -}}
            <br>
          </p>
        </div>

        {% assign index_in_group = forloop.index0 | modulo: 5 %}
        {% if index_in_group < 4 %}
          <!-- SMALL POST (Articles 1..4 in each group) -->
          <div class="small-post">
            <div class="small-post__image-wrap">
              {% if article.image %}
                <a href="{{ article.url }}">
                  <img
                    class="small-post__image"
                    src="{{ article.image.src | image_url: width: 500 }}"
                    alt="{{ article.image.src.alt | escape }}"
                  >
                </a>
              {% endif %}
            </div>
            <div class="small-post__content">
              <h3 class="small-post__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              <p class="small-post__meta">
                {{ article.published_at | time_tag: format: 'date' }}
                {% if article.author %} &nbsp;|&nbsp; By {{ article.author }}{% endif %}
              </p>
              {% if article.excerpt %}
                <p class="small-post__excerpt">
                  {{ article.excerpt | strip_html | truncatewords: 20 }}
                </p>
              {% endif %}
            </div>
          </div>
        {% else %}
          <!-- BIG POST (The 5th article in each group) -->
          <div class="big-post">
            <div class="big-post__image-wrap">
              {% if article.image %}
                <a href="{{ article.url }}">
                  <img
                    class="big-post__image"
                    src="{{ article.image.src | image_url: width: 1200 }}"
                    alt="{{ article.image.src.alt | escape }}"
                  >
                </a>
              {% endif %}
            </div>
            <div class="big-post__content">
              <h3 class="big-post__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              <p class="big-post__meta">
                {{ article.published_at | time_tag: format: 'date' }}
                {% if article.author %} &nbsp;|&nbsp; By {{ article.author }}{% endif %}
              </p>
              {% if article.excerpt %}
                <p class="big-post__excerpt">
                  {{ article.excerpt | strip_html | truncatewords: 25 }}
                </p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      <!-- ========== PAGINATION ========== -->
      {% if paginate.pages > 1 %}
        <div class="pagination">
          {%- render 'pagination', paginate: paginate -%}
        </div>
      {% endif %}
    {%- endif -%}
  </div>
{%- endpaginate %}

<style>
  /* ====== Hero Article Styles ====== */
  .hero-article {
    position: relative;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .hero-article__image-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .hero-article__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .hero-article__overlay {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 1.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    color: #fff;
  }
  .hero-article__title {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    line-height: 1.1;
    font-weight: bold;
  }
  .hero-article__meta {
    font-size: 0.875rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }
  .hero-article__excerpt {
    font-size: 1rem;
    line-height: 1.4;
  }

  /* ====== Small Post Styles ====== */
  .small-post {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .small-post__image-wrap {
    flex: 0 0 200px;
    overflow: hidden;
  }
  .small-post__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .small-post__content {
    flex: 1;
  }
  .small-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.25rem;
    font-weight: bold;
  }
  .small-post__title a {
    text-decoration: none;
    color: inherit;
  }
  .small-post__meta {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }
  .small-post__excerpt {
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* ====== Big Post Styles ====== */
  .big-post {
    margin-bottom: 2rem;
  }
  .big-post__image-wrap {
    margin-bottom: 0.5rem;
  }
  .big-post__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .big-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
    font-weight: bold;
  }
  .big-post__title a {
    text-decoration: none;
    color: inherit;
  }
  .big-post__meta {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }
  .big-post__excerpt {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  /* ====== Pagination ====== */
  .pagination {
    margin-top: 2rem;
    text-align: center;
  }
</style>
