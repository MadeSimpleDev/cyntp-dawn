{%- comment -%}
  Final Hero + Big/Small leftover with "Load More" button
  - No debug block
  - No Liquid pagination
  - If leftover_count <= 5, you’ll see them all immediately.
  - If leftover_count > 5, you can load subsequent groups in increments of 5.
{%- endcomment -%}

{% assign all_articles = blog.articles %}
{% assign first_article = all_articles | first %}

{% if all_articles.size == 0 %}
  <p>No articles found.</p>
{% else %}
  <!-- 1) HERO ARTICLE -->
  {% if first_article %}
    <div class="hero-article">
      <a href="{{ first_article.url }}" class="hero-article__link">
        {% if first_article.image %}
          <img
            class="hero-article__image"
            src="{{ first_article.image.src | image_url: width: 1600 }}"
            alt="{{ first_article.image.src.alt | escape }}"
          >
        {% endif %}
        <div class="hero-article__overlay">
          <!-- Title is white, bold, italic -->
          <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
          <p class="hero-article__meta">
            {{ first_article.published_at | time_tag: format: 'date' }}
            {% if first_article.author %} | By {{ first_article.author }}{% endif %}
          </p>
          {% if first_article.excerpt %}
            <p class="hero-article__excerpt">{{ first_article.excerpt | strip_html | truncatewords: 30 }}</p>
          {% endif %}
        </div>
      </a>
    </div>
  {% endif %}

  <!-- 2) LEFTOVER ARTICLES IN GROUPS OF 5 -->
  {% assign leftover_articles = all_articles | slice: 1, all_articles.size %}
  {% assign leftover_count = leftover_articles.size %}

  {% if leftover_count > 0 %}
    {# Compute how many leftover groups we have #}
    {% assign group_count = leftover_count | divided_by: 5 %}
    {% assign remainder = leftover_count | modulo: 5 %}
    {% if remainder > 0 %}
      {% assign group_count = group_count | plus: 1 %}
    {% endif %}
    {% assign group_count_minus1 = group_count | minus: 1 %}

    {# Build an array "groups" to hold each group as JSON #}
    {% assign groups = '' | split: ',' %}
    {% for i in (0..group_count_minus1) %}
      {% assign startIndex = i | times: 5 %}
      {% assign groupSlice = leftover_articles | slice: startIndex | slice: 0, 5 %}
      {% capture groupJson %}{{ groupSlice | json }}{% endcapture %}
      {% assign groups = groups | push: groupJson %}
    {% endfor %}

    <!-- Container for leftover articles -->
    <div id="LeftoverArticleContainer"></div>

    <!-- If more than 1 group, show the "Load More" button -->
    {% if group_count > 1 %}
      <div class="load-more-wrapper">
        <button id="LoadMoreBtn" class="load-more-button">Load more posts</button>
      </div>
    {% endif %}

    <!-- We'll embed leftover groups in JSON for JS to parse -->
    <script type="application/json" id="LeftoverGroupsData">
      {{ groups | json }}
    </script>

    <script>
      (function () {
        var dataEl = document.getElementById('LeftoverGroupsData');
        if (!dataEl) return; // no leftover
        var leftoverGroups = JSON.parse(dataEl.textContent);
        // leftoverGroups is an array of JSON-strings, each string is up to 5 articles
        var containerEl = document.getElementById('LeftoverArticleContainer');
        var loadMoreBtn = document.getElementById('LoadMoreBtn');
        var currentIndex = 0;

        function renderGroup(groupJson) {
          var groupArticles = JSON.parse(groupJson);
          var groupHTML = '';

          for (var i = 0; i < groupArticles.length; i++) {
            var art = groupArticles[i];
            var indexInGroup = i; // 0..4
            var cardClass = indexInGroup < 4 ? 'small-post' : 'big-post';
            var widthVal = indexInGroup < 4 ? 500 : 1200;

            var imageHTML = '';
            if (art.image) {
              imageHTML = `
              <div class="${cardClass}__image-wrap">
                <img class="${cardClass}__image"
                     src="${art.image.src}?width=${widthVal}"
                     alt="${art.image.alt ? art.image.alt : ''}"
                />
              </div>
            `;
            }

            // entire card is clickable
            var postHTML = `
            <a class="${cardClass} clickable-card" href="${art.url}">
              ${imageHTML}
              <div class="${cardClass}__content">
                <h3 class="${cardClass}__title" style="margin:0 0 .3rem; font-size:1.25rem; font-weight:bold;">
                  ${art.title}
                </h3>
                <p class="${cardClass}__meta" style="font-size:.875rem; opacity:.8; margin-bottom:.5rem;">
                  ${art.published_at}
                  ${art.author ? ' | By ' + art.author : ''}
                </p>
                ${
                  art.summary_html
                    ? `<p class="${cardClass}__excerpt" style="font-size:.9rem; line-height:1.4;">${art.summary_html}</p>`
                    : ''
                }
              </div>
            </a>
          `;
            groupHTML += postHTML;
          }
          var wrapper = document.createElement('div');
          wrapper.innerHTML = groupHTML;
          containerEl.appendChild(wrapper);
        }

        // Render the 1st group immediately (if any)
        if (leftoverGroups.length > 0) {
          renderGroup(leftoverGroups[currentIndex]);
        }

        if (loadMoreBtn) {
          // If only 1 group, hide the button
          if (leftoverGroups.length <= 1) {
            loadMoreBtn.style.display = 'none';
          }
          loadMoreBtn.addEventListener('click', function () {
            currentIndex++;
            if (currentIndex < leftoverGroups.length) {
              renderGroup(leftoverGroups[currentIndex]);
            }
            if (currentIndex >= leftoverGroups.length - 1) {
              loadMoreBtn.style.display = 'none';
            }
          });
        }
      })();
    </script>
  {% endif %}
{% endif %}

<!-- Minimal styling -->
<style>
  /* Hero Container */
  .hero-article {
    position: relative;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .hero-article__link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .hero-article__image {
    width: 100%;
    display: block;
    object-fit: cover;
  }
  .hero-article__overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    background: rgba(0, 0, 0, 0);
    justify-content: flex-start;
  }
  .hero-article__title {
    margin: 0 0 0.5rem;
    color: #fff;
    font-weight: bold;
    font-style: italic;
    font-size: 2rem;
    line-height: 1.1;
  }
  @media screen and (min-width: 750px) {
    .hero-article__overlay {
      width: 40%;
      background: rgba(0, 0, 0, 0.4);
      align-items: flex-start;
    }
  }
  @media screen and (max-width: 749px) {
    .hero-article__image {
      min-height: 60vh;
    }
    .hero-article__overlay {
      justify-content: flex-end;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
      padding-bottom: 2rem;
    }
  }
  /* Entire leftover card clickable */
  .clickable-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-bottom: 2rem;
    background: #fff;
    border: 1px solid #ddd;
    padding: 1rem;
  }
  .clickable-card:hover {
    transform: scale(1.01);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
  }
  /* SMALL POST */
  .small-post {
    display: flex;
    gap: 1rem;
  }
  .small-post__image-wrap {
    flex: 0 0 200px;
    overflow: hidden;
  }
  .small-post__image {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .small-post__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  /* BIG POST */
  .big-post .big-post__image-wrap {
    margin-bottom: 0.5rem;
    overflow: hidden;
  }
  .big-post__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .load-more-wrapper {
    margin-top: 2rem;
    text-align: center;
  }
  .load-more-button {
    padding: 0.75rem 1.5rem;
    background: #333;
    color: #fff;
    border: none;
    cursor: pointer;
    border-radius: 4px;
  }
  .load-more-button:hover {
    opacity: 0.9;
  }
</style>
