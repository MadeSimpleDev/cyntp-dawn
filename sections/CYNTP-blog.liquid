{% assign all_articles = blog.articles %}
{% assign first_article = all_articles | first %}

{% if all_articles.size == 0 %}
  <p>No articles found.</p>
{% else %}
  <!-- =====================
       1) LARGE (Hero) Post
       ===================== -->
  {% if first_article %}
    <div class="hero-article">
      <!-- Entire Hero card clickable -->
      <a href="{{ first_article.url }}" class="hero-article__link">
        {% if first_article.image %}
          <img
            class="hero-article__image"
            src="{{ first_article.image | image_url: width: 1600 }}"
            alt="{{ first_article.image.alt | default: '' }}"
          >
        {% endif %}
        <div class="hero-article__overlay">
          <!-- All text white -->
          <h2 class="hero-article__title" style="color: #fff;">
            {{ first_article.title | escape }}
          </h2>
          <p class="hero-article__meta" style="color: #fff;">
            {{ first_article.published_at | time_tag: format: 'date' }}
            {% if first_article.author %} | By {{ first_article.author }}{% endif %}
          </p>
          {% if first_article.excerpt %}
            <p class="hero-article__excerpt" style="color: #fff;">
              {{ first_article.excerpt | strip_html | truncatewords: 30 }}
            </p>
          {% endif %}
        </div>
      </a>
    </div>
  {% endif %}

  <!-- =====================
       2) LEFTOVER ARTICLES
       ===================== -->
  {% assign leftover_articles = all_articles | slice: 1, all_articles.size %}
  {% assign leftover_count = leftover_articles.size %}

  {% if leftover_count > 0 %}
    {% assign group_count = leftover_count | divided_by: 5 %}
    {% assign remainder = leftover_count | modulo: 5 %}
    {% if remainder > 0 %}
      {% assign group_count = group_count | plus: 1 %}
    {% endif %}
    {% assign group_count_minus1 = group_count | minus: 1 %}

    <!-- Each group up to 5 leftover articles -->
    {% for i in (0..group_count_minus1) %}
      {% assign startIndex = i | times: 5 %}
      {% assign chunkArticles = leftover_articles | slice: startIndex, 5 %}

      {% if forloop.first %}
        <div class="leftover-chunk leftover-chunk-{{ i }}" style="display: block;">
      {% else %}
        <div class="leftover-chunk leftover-chunk-{{ i }}" style="display: none;">
      {% endif %}
        {% for article in chunkArticles %}
          {% assign indexInGroup = forloop.index0 %}
          {% if indexInGroup < 4 %}
            {% assign cardClass = "small-post" %}
            {% assign widthVal = 1200 %}  <!-- ~20% bigger than 1000 -->
          {% else %}
            {% assign cardClass = "medium-post" %}
            {% assign widthVal = 1400 %}
          {% endif %}

          <!-- Entire leftover card clickable -->
          <a class="{{ cardClass }} clickable-card" href="{{ article.url }}">
            {% if article.image %}
              <div class="{{ cardClass }}__image-wrap">
                <img class="{{ cardClass }}__image"
                     src="{{ article.image | image_url: width: widthVal }}"
                     alt="{{ article.image.alt | default: '' }}"
                >
              </div>
            {% endif %}
            <!-- 
              Thin gray top border.
              We do it for both small & medium. 
            -->
            <div class="{{ cardClass }}__content"
                 style="border-top:1px solid #ccc; position:relative;"
            >
              <!-- Centered on the image? We'll overlay the text.
                   We'll make the .__content itself an overlay with absolute positioning.
                   Then the image-wrap is relative.
               -->
              {% if cardClass == "small-post" %}
                <!-- date only, no time -->
                {% assign dateValue = article.published_at | date: "%B %d, %Y" %}
              {% else %}
                <!-- medium => original time_tag date, or you can do date only if you prefer -->
                {% assign dateValue = article.published_at | time_tag: format: 'date' %}
              {% endif %}

              <!-- We'll wrap the text in a sub-element with absolute overlay + text-align center -->
              <div class="{{ cardClass }}__overlay-text">
                <h3 class="{{ cardClass }}__title" style="font-size:1.25rem; font-weight:bold; margin-bottom:.3rem; color:#fff;">
                  {{ article.title }}
                </h3>
                <p class="{{ cardClass }}__meta" style="font-size:.875rem; opacity:.9; margin-bottom:.5rem; color:#fff;">
                  {{ dateValue }}
                  {% if article.author %} | By {{ article.author }}{% endif %}
                </p>
                {% if article.summary_html %}
                  <!-- Show excerpt from article -->
                  <p class="{{ cardClass }}__excerpt" style="font-size:.9rem; line-height:1.4; color:#fff;">
                    {{ article.summary_html | strip_html | truncatewords: 25 }}
                  </p>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endfor %}

    <!-- If multiple groups, show "Load More" button -->
    {% if group_count > 1 %}
      <div class="load-more-wrapper" style="margin-top:2rem; text-align:center;">
        <button id="LoadMoreBtn" class="load-more-button"
          style="padding:.75rem 1.5rem; background:#333; color:#fff; border:none; 
                 cursor:pointer; border-radius:4px;"
        >
          Load more posts
        </button>
      </div>
      <script>
      (function(){
        var totalGroups = {{ group_count }};
        var currentIndex = 0;
        var loadMoreBtn = document.getElementById('LoadMoreBtn');

        loadMoreBtn.addEventListener('click', function(){
          var nextIndex = currentIndex + 1;
          var nextChunk = document.querySelector('.leftover-chunk-' + nextIndex);
          if(nextChunk){
            nextChunk.style.display = 'block';
            currentIndex = nextIndex;
          }
          if(currentIndex >= totalGroups -1){
            loadMoreBtn.style.display='none';
          }
        });
      })();
      </script>
    {% endif %}
  {% endif %}
{% endif %}

<style>
/* 1) Large/Hero Post */
.hero-article {
  position: relative;
  margin-bottom: 2rem;
  overflow: hidden;
}
.hero-article__link {
  display: block;
  text-decoration: none;
  color: inherit;
  position: relative;
  /* half as tall, or a bit bigger => let's do ~ 400 max-height */
  border-top:1px solid #ccc; /* thin gray border on top if you prefer */
}
.hero-article__image {
  width: 100%;
  max-height: 400px;
  object-fit: cover;
  display: block;
}
.hero-article__overlay {
  position: absolute;
  top: 0; bottom: 0; left: 0; right: 0;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  background: rgba(0,0,0,0);
  justify-content: flex-start;
}
@media screen and (min-width:750px){
  .hero-article__overlay {
    width:40%;
    background: rgba(0,0,0,0.4);
    align-items:flex-start;
  }
}
@media screen and (max-width:749px){
  /* or min-height: 40vh if you want bigger on mobile */
  .hero-article__image {
    min-height:30vh;
  }
  .hero-article__overlay {
    justify-content:flex-end;
    background: linear-gradient(to top, rgba(0,0,0,.5), transparent);
    padding-bottom:2rem;
  }
}
/* 2) Leftover Cards */
.clickable-card {
  display: block;
  text-decoration: none;
  color: inherit;
  background: none;
  border: none;
  border-radius: 0;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  margin-bottom: 2rem; 
  /* We do padding inside the .__content or .__image-wrap if needed */
}
.clickable-card:hover {
  transform: scale(1.01);
  box-shadow: 0 3px 6px rgba(0,0,0,.15);
}
/* 2A) Small Post */
.small-post {
  position: relative; /* we'll place text overlay over the image */
}
.small-post__image-wrap {
  position: relative;
}
.small-post__image {
  width:100%;
  height:auto;
  object-fit: cover;
  display:block;
  /* if you want half as tall => max-height:300px */
}
/* text overlay => we center text on the image */
.small-post__content {
  position: relative; /* we do the overlay inside .__overlay-text */
  min-height: 250px; /* ensure some vertical space */
}
/* overlay text absolute center */
.small-post__overlay-text {
  position: absolute;
  top:0; left:0; right:0; bottom:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  background: rgba(0,0,0,0.4);
}
/* 2B) Medium Post */
.medium-post {
  position: relative;
}
.medium-post__image-wrap {
  position: relative;
}
.medium-post__image {
  width:100%;
  height:auto;
  display:block;
  max-height:300px; /* half as tall */
  object-fit: cover;
}
.medium-post__content {
  position: relative;
  min-height: 250px;
}
.medium-post__overlay-text {
  position:absolute;
  top:0; left:0; right:0; bottom:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  background: rgba(0,0,0,0.4);
  color:#fff;
}
/* 
  3) "Load More" button 
*/
.load-more-wrapper {
  margin-top:2rem;
  text-align:center;
}
.load-more-button {
  padding:.75rem 1.5rem;
  background:#333;
  color:#fff;
  border:none;
  cursor:pointer;
  border-radius:4px;
}
.load-more-button:hover {
  opacity:.9;
}
</style>
