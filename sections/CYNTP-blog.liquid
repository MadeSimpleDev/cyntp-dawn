{% assign all_articles = blog.articles %}
{% assign first_article = all_articles | first %}

{% if all_articles.size == 0 %}
  <p>No articles found.</p>
{% else %}
  <!-- =====================
       1) HERO ("Large") 
       ===================== -->
  {% if first_article %}
    <div class="hero-article">
      <!-- Thin gray border on top for "large" card -->
      <a href="{{ first_article.url }}" class="hero-article__link" style="border-top:1px solid #ccc;">
        {% if first_article.image %}
          <img
            class="hero-article__image"
            src="{{ first_article.image | image_url: width: 1600 }}"
            alt="{{ first_article.image.alt | default: '' }}"
          >
        {% endif %}
        <div class="hero-article__overlay">
          {% comment %} Add Tag Display Here {% endcomment %}
          {% assign first_tag = first_article.tags | first %}
          {% if first_tag %}
            <span class="article-tag">{{ first_tag | upcase }}</span>
          {% endif %}
          {% comment %} End Tag Display {% endcomment %}
          <!-- Title is white, bold, italic -->
          <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
          {% comment %} Remove the meta paragraph below {% endcomment %}
          {% comment %}
          <p class="hero-article__meta">
            {{ first_article.published_at | time_tag: format: 'date' }}
            {% if first_article.author %} | By {{ first_article.author }}{% endif %}
          </p>
          {% endcomment %}
          {% if first_article.excerpt %}
            <p class="hero-article__excerpt">
              {{ first_article.excerpt | strip_html | truncatewords: 30 }}
            </p>
          {% endif %}
        </div>
      </a>
    </div>
  {% endif %}

  <!-- =====================
       2) LEFTOVER ARTICLES
       ===================== -->
  {% assign leftover_articles = all_articles | slice: 1, all_articles.size %}
  {% assign leftover_count = leftover_articles.size %}

  {% if leftover_count > 0 %}
    {% assign group_count = leftover_count | divided_by: 5 %}
    {% assign remainder = leftover_count | modulo: 5 %}
    {% if remainder > 0 %}
      {% assign group_count = group_count | plus: 1 %}
    {% endif %}
    {% assign group_count_minus1 = group_count | minus: 1 %}

    <!-- Add this container div -->
    <div class="leftover-articles-container">
      <!--
        Each group = up to 5 leftover articles.
        The 1st chunk is displayed, the rest hidden.
        "Load More" will unhide each subsequent chunk.
      -->
      {% for i in (0..group_count_minus1) %}
        {% assign startIndex = i | times: 5 %}
        {% assign chunkArticles = leftover_articles | slice: startIndex, 5 %}

        {% if forloop.first %}
          <div class="leftover-chunk leftover-chunk-{{ i }}" style="display: block;">
        {% else %}
          <div class="leftover-chunk leftover-chunk-{{ i }}" style="display: none;">
        {% endif %}
          <!-- Loop each article in this chunk -->
          {% for article in chunkArticles %}
            {% assign indexInGroup = forloop.index0 %}

            {% if indexInGroup < 4 %}
              {% assign cardClass = "small-post" %}
              {% assign widthVal = 1000 %} <!-- Twice as large as 500 -->
            {% else %}
              {% assign cardClass = "medium-post" %}
              {% assign widthVal = 1200 %}
            {% endif %}

            <a class="{{ cardClass }} clickable-card" href="{{ article.url }}">
              {% if article.image %}
                <div class="{{ cardClass }}__image-wrap">
                  <img class="{{ cardClass }}__image"
                       src="{{ article.image | image_url: width: widthVal }}"
                       alt="{{ article.image.alt | default: '' }}"
                  >
                </div>
              {% endif %}
              <div class="{{ cardClass }}__content"
                   {% if cardClass == "medium-post" %}
                     style="border-top:1px solid #ccc;"
                   {% endif %}
              >
                {% comment %} New Meta Structure for Small Post {% endcomment %}
                {% assign current_tag = article.tags | first %}
                <div class="small-post__meta-desktop">
                  {% if current_tag %}<span class="article-tag">{{ current_tag | upcase }}</span>{% endif %}
                  <span class="small-post__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
                  {% if article.author %} | By {{ article.author }}{% endif %}
                </div>
                <div class="small-post__meta-mobile">
                   {% if current_tag %}<span class="article-tag">{{ current_tag | upcase }}</span>{% endif %}
                   <span class="small-post__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
                   {% if article.author %} | By {{ article.author }}{% endif %}
                </div>
                {% comment %} End New Meta Structure {% endcomment %}

                <h3 class="{{ cardClass }}__title"
                    style="margin:0 0 .3rem; font-size:1.25rem; font-weight:bold;">
                  {{ article.title }}
                </h3>
                {% comment %} Remove old meta paragraph {% endcomment %}
                {% comment %}
                <p class="{{ cardClass }}__meta" style="font-size:.875rem; opacity:.8; margin-bottom:.5rem;">
                  {% if cardClass == "small-post" %}
                    <!-- small => show date only, no time -->
                    {{ article.published_at | date: "%B %d, %Y" }}
                  {% else %}
                    <!-- medium => keep original time or date? If you also want date only, do the same line. -->
                    {{ article.published_at | time_tag: format: 'date' }}
                  {% endif %}
                  {% if article.author %} | By {{ article.author }}{% endif %}
                </p>
                {% endcomment %}
                <!-- Shorter excerpt on leftover - Increased truncatewords -->
                {% comment %} Check if article.summary_html exists in Shopify admin for articles appearing here {% endcomment %}
                {% if article.summary_html %}
                  <p class="{{ cardClass }}__excerpt" style="font-size:.9rem; line-height:1.4;">
                    {{ article.summary_html | strip_html | truncatewords: 20 }}
                  </p>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div> <!-- Moved this closing div tag outside the inner for loop -->
      {% endfor %}
    <!-- Close the container div -->
    </div>

    {% if group_count > 1 %}
      <div class="load-more-wrapper" style="margin-top:2rem; text-align:center;">
        <button id="LoadMoreBtn" class="load-more-button"
                style="padding:.75rem 1.5rem; background:#333; color:#fff; border:none; 
                       cursor:pointer; border-radius:4px;">
          Load more posts
        </button>
      </div>
      <script>
      (function(){
        var totalGroups = {{ group_count }};
        var currentIndex = 0;
        var loadMoreBtn = document.getElementById('LoadMoreBtn');

        loadMoreBtn.addEventListener('click', function(){
          var nextIndex = currentIndex + 1;
          var nextChunk = document.querySelector('.leftover-chunk-' + nextIndex);
          if(nextChunk){
            nextChunk.style.display='block';
            currentIndex = nextIndex;
          }
          if(currentIndex >= totalGroups -1){
            loadMoreBtn.style.display='none';
          }
        });
      })();
      </script>
    {% endif %}
  {% endif %}
{% endif %}

<style>
/* Existing styles... */
.hero-article {
  position: relative;
  margin-bottom: 2rem;
  overflow: hidden;
  /* Add max-width and center for desktop */
  max-width: 100%; /* Default full width */
}
@media screen and (min-width: 990px) { /* Apply only on larger screens */
  .hero-article {
    max-width: 70%;
    margin-left: auto;
    margin-right: auto;
  }
  /* Add this rule for the new container */
  .leftover-articles-container {
    max-width: 70%;
    margin-left: auto;
    margin-right: auto;
  }
}
.hero-article__link {
  display: block;
  text-decoration: none;
  color: inherit;
  position: relative;
}
.hero-article__image {
  width: 100%;
  object-fit: cover;
  max-height: 300px; /* Default max height */
  display: block;
}
@media screen and (min-width: 750px) { /* Increase image height on desktop */
  .hero-article__image {
    max-height: 450px; /* Increased height */
  }
}
.hero-article__overlay {
  position: absolute;
  top: 0; bottom: 0; left: 0; right: 0;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  /* Adjust gradient to be lighter */
  background: rgba(0,0,0,0.3); /* Lighter overlay */
  /* Vertically center content */
  justify-content: center;
  /* Ensure all text is white */
  color: #fff;
}
/* Add style for the new tag element */
.article-tag {
  display: inline-block;
  background-color: red;
  color: white;
  padding: 0.2em 0.6em;
  font-size: 0.8rem;
  font-weight: bold;
  text-transform: uppercase;
  border-radius: 3px;
  margin-bottom: 0.5rem; /* Space below tag */
}
.hero-article__title {
  margin: 0 0 .5rem;
  color: #fff; /* Ensure white */
  font-weight: bold;
  font-style: italic;
  /* Increase font size */
  font-size: 3.5rem; /* Increased from 2.5rem */
  line-height:1.1;
  text-wrap: balance; /* Add text wrapping */
}
/* Add rule for hero meta and excerpt text color and size */
.hero-article__meta, /* Keep style rule even if element removed, for potential future use */
.hero-article__excerpt {
  color: #fff; /* Ensure white */
  /* Increase excerpt font size */
  font-size: 2rem; /* Increased from 1rem */
  text-wrap: pretty; /* Add text wrapping */
}
.hero-article__meta {
  margin-bottom: 0.5rem;
}

@media screen and (min-width: 750px){
  .hero-article__overlay {
    width:40%;
    /* Adjust gradient */
    background: rgba(0,0,0,0.3);
    align-items:flex-start; /* Keep left align on desktop */
  }
}
@media screen and (max-width: 749px){
  .hero-article__image {
    min-height:30vh; /* half of 60vh */
  }
  .hero-article__overlay {
    /* Keep vertical centering */
    justify-content: center;
    /* Adjust gradient */
    background: linear-gradient(to top, rgba(0,0,0,.4), transparent);
    padding-bottom:2rem;
    align-items: center; /* Center align text horizontally on mobile */
    text-align: center; /* Center text */
  }
  .hero-article__title {
    font-size: 2.5rem; /* Adjusted for mobile */
  }
  .hero-article__meta,
  .hero-article__excerpt {
    font-size: 1.5rem; /* Adjusted excerpt size for mobile */
  }
}
.clickable-card {
  display: block;
  text-decoration: none;
  color: inherit;
  /* Remove background color / border from leftover */
  background: none;
  border: none;
  border-radius: 0;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  margin-bottom: 2rem;
  padding: 1rem;
}
.clickable-card:hover {
  transform: scale(1.01);
  box-shadow: 0 3px 6px rgba(0,0,0,.15);
}
.small-post {
  display: flex;
  gap: 1rem;
  align-items: stretch; /* Ensure columns have same height */
}
.small-post__image-wrap {
  flex: 0 0 200px; /* Default for mobile */
  overflow: hidden;
}
/* Increase image width on desktop */
@media screen and (min-width: 750px) {
  .small-post__image-wrap {
    flex: 0 0 300px; /* Increased width for desktop */
  }
}
.small-post__image {
  width: 100%;
  height: 100%; /* Make image fill the container height */
  object-fit: cover;
  display: block;
}
/* Align text content to top */
.small-post__content {
  display: flex;
  flex-direction: column;
  /* Align content to the top */
  justify-content: flex-start;
  flex: 1; /* Allow content to take remaining space */
}
/* Styles for new meta structure */
.small-post__meta-desktop { display: none; } /* Hide by default */
.small-post__meta-mobile { display: block; } /* Show by default */
.small-post__meta-desktop .article-tag,
.small-post__meta-mobile .article-tag {
   margin-right: 0.5rem; /* Space between tag and date */
}
.small-post__date { /* Style for date part */
   font-size: .875rem; opacity:.8;
}
.small-post__meta-desktop,
.small-post__meta-mobile {
   margin-bottom: 0.5rem; /* Space below meta line */
   font-size:.875rem; opacity:.8;
   text-wrap: pretty; /* Apply pretty wrap */
}
/* Increase font sizes for small posts */
.small-post__title {
  font-size: 1.5rem !important; /* Increased size */
  font-weight: bold !important;
  margin: 0 0 0.4rem !important;
  text-wrap: balance; /* Add text wrapping */
}
/* Remove old .small-post__meta rule */
/*
.small-post__meta {
  font-size: 1rem !important; *//* Increased size *//*
  opacity: .8 !important;
  margin-bottom: 0.6rem !important;
  text-wrap: pretty; *//* Add text wrapping *//*
}
*/
.small-post__excerpt {
  font-size: 1rem !important; /* Increased size */
  line-height: 1.5 !important;
  text-wrap: pretty; /* Add text wrapping */
}

.medium-post__image-wrap {
  margin-bottom: .5rem;
  overflow: hidden;
}
.medium-post__image {
  max-height: 300px; /* half as tall as before */
  width: 100%;
  object-fit: cover;
  display: block;
}
/* Styles for new medium post meta */
.medium-post__meta-line {
   margin-bottom: 0.5rem; /* Space below meta line */
   font-size: 1rem; /* Copied from old .medium-post__meta */
   opacity: .8; /* Copied from old .medium-post__meta */
   text-wrap: pretty; /* Keep this */
}
.medium-post__meta-line .article-tag {
   margin-right: 0.5rem; /* Space between tag and date */
}
/* Increase font sizes for medium posts */
.medium-post__title {
  font-size: 1.75rem !important; /* Increased size */
  font-weight: bold !important;
  margin: 0 0 0.5rem !important;
  text-wrap: balance; /* Add text wrapping */
}
/* Remove old .medium-post__meta rule */
/*
.medium-post__meta {
  font-size: 1rem !important; *//* Increased size *//*
  opacity: .8 !important;
  margin-bottom: 0.7rem !important;
  text-wrap: pretty; *//* Add text wrapping *//*
}
*/
.medium-post__excerpt {
  font-size: 1.1rem !important; /* Increased size */
  line-height: 1.5 !important;
  text-wrap: pretty; /* Add text wrapping */
}

/* Media Queries for Small Post Meta and Excerpt */
@media screen and (min-width: 750px) {
  .small-post__meta-desktop { display: block; } /* Show desktop meta */
  .small-post__meta-mobile { display: none; } /* Hide mobile meta */
  .small-post__excerpt { display: block !important; } /* Ensure excerpt shows on desktop */
}

@media screen and (max-width: 749px) {
  .small-post__excerpt { display: none; } /* Hide excerpt on mobile */
  .small-post__meta-desktop { display: none; } /* Ensure desktop meta hidden */
  .small-post__meta-mobile { display: block; } /* Ensure mobile meta shown */
}
</style>