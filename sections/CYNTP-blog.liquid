{%- comment -%}
  Final "Hero / Big / Small" Blog Section
  - First article = Hero
  - Remaining in groups of 5: 4 small-post, then 1 big-post
  - Paginate by 10
{%- endcomment -%}

{%- paginate blog.articles by 10 -%}
  {%- assign articles = paginate.items -%}
  {%- assign first_article = articles | first -%}

  {% if articles.size == 0 %}
    <!-- If no articles in this pagination slice, just say so -->
    <p>No articles found.</p>
  {% else %}
    <!-- HERO: The very first article -->
    {% if first_article %}
      <div class="hero-article">
        <a href="{{ first_article.url }}" class="hero-article__image-link">
          {% if first_article.image %}
            <img
              class="hero-article__image"
              src="{{ first_article.image.src | image_url: width: 1600 }}"
              alt="{{ first_article.image.src.alt | escape }}"
            >
          {% endif %}
          <div class="hero-article__overlay">
            <h2 class="hero-article__title">{{ first_article.title | escape }}</h2>
            <p class="hero-article__meta">
              {{ first_article.published_at | time_tag: format: 'date' }}
              {% if first_article.author %} &nbsp;|&nbsp; By {{ first_article.author }}{% endif %}
            </p>
            {% if first_article.excerpt %}
              <p class="hero-article__excerpt">{{ first_article.excerpt | strip_html | truncatewords: 30 }}</p>
            {% endif %}
          </div>
        </a>
      </div>
    {% endif %}

    <!-- NEXT ARTICLES: offset=1, grouped by 5 (4 small + 1 big) -->
    {% for article in articles offset: 1 %}
      {% assign index_in_group = forloop.index0 | modulo: 5 %}

      {% if index_in_group < 4 %}
        <!-- SMALL-POST (first 4 in each group of 5) -->
        <div class="small-post">
          <div class="small-post__image-wrap">
            {% if article.image %}
              <a href="{{ article.url }}">
                <img
                  class="small-post__image"
                  src="{{ article.image.src | image_url: width: 500 }}"
                  alt="{{ article.image.src.alt | escape }}"
                >
              </a>
            {% endif %}
          </div>
          <div class="small-post__content">
            <h3 class="small-post__title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>
            <p class="small-post__meta">
              {{ article.published_at | time_tag: format: 'date' }}
              {% if article.author %} &nbsp;|&nbsp; By {{ article.author }}{% endif %}
            </p>
            {% if article.excerpt %}
              <p class="small-post__excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
            {% endif %}
          </div>
        </div>

      {% else %}
        <!-- BIG-POST (the 5th in each group of 5) -->
        <div class="big-post">
          <div class="big-post__image-wrap">
            {% if article.image %}
              <a href="{{ article.url }}">
                <img
                  class="big-post__image"
                  src="{{ article.image.src | image_url: width: 1200 }}"
                  alt="{{ article.image.src.alt | escape }}"
                >
              </a>
            {% endif %}
          </div>
          <div class="big-post__content">
            <h3 class="big-post__title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>
            <p class="big-post__meta">
              {{ article.published_at | time_tag: format: 'date' }}
              {% if article.author %} &nbsp;|&nbsp; By {{ article.author }}{% endif %}
            </p>
            {% if article.excerpt %}
              <p class="big-post__excerpt">{{ article.excerpt | strip_html | truncatewords: 25 }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <!-- PAGINATION if more than 1 page -->
    {% if paginate.pages > 1 %}
      <div class="pagination">
        {%- render 'pagination', paginate: paginate -%}
      </div>
    {% endif %}
  {% endif %}
{%- endpaginate %}

<!-- Minimal sample styling -->
<style>
  .hero-article {
    position: relative;
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .hero-article__image-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .hero-article__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .hero-article__overlay {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 1.5rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    color: #fff;
  }
  .hero-article__title {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: bold;
    line-height: 1.1;
  }
  .hero-article__meta {
    font-size: 0.875rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }
  .hero-article__excerpt {
    font-size: 1rem;
    line-height: 1.4;
  }

  .small-post {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .small-post__image-wrap {
    flex: 0 0 200px;
    overflow: hidden;
  }
  .small-post__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .small-post__content {
    flex: 1;
  }
  .small-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.25rem;
    font-weight: bold;
  }
  .small-post__meta {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .big-post {
    margin-bottom: 2rem;
  }
  .big-post__image-wrap {
    margin-bottom: 0.5rem;
  }
  .big-post__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  .big-post__title {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
    font-weight: bold;
  }
  .big-post__meta {
    font-size: 0.875rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .pagination {
    margin-top: 2rem;
    text-align: center;
  }
</style>
