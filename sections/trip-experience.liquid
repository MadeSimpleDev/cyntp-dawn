{% comment %} /sections/trip-experience.liquid {% endcomment %}
{{ 'section-trip-experience.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% liquid
  ##################################################################
  # 1) Try to get the metaobject (from section setting or page)
  ##################################################################
  assign current_metaobject = metaobject

  # If no metaobject was directly assigned, but we are on a metaobject page,
  # then the global 'metaobject' might apply
  if current_metaobject == blank and request.page_type == 'metaobject'
    assign current_metaobject = metaobject
  endif

  # 2) Extract the trip_video_url and metaobject ID if available
  assign raw_video_url = ''
  assign current_trip_id = ''

  if current_metaobject
    assign raw_video_url = current_metaobject.trip_video_url.value
    assign current_trip_id = current_metaobject.id
  endif

  ##################################################################
  # 3) Build an embed URL for YouTube or Vimeo if raw_video_url is set
  ##################################################################
  assign video_embed_url = ''
  assign video_id = ''
  assign video_host = ''

  # Strip out "www." so that your if/elsif checks match "youtube.com" or "youtu.be"
  assign sanitized_url = raw_video_url | replace: 'www.', ''

  if sanitized_url contains 'youtube.com/watch?v='
    assign video_id = sanitized_url | split: 'v=' | last | split: '&' | first
    assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?enablejsapi=1&autoplay=1'
    assign video_host = 'youtube'
  elsif sanitized_url contains 'youtu.be/'
    assign video_id = sanitized_url | split: 'youtu.be/' | last | split: '?' | first
    assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?enablejsapi=1&autoplay=1'
    assign video_host = 'youtube'
  elsif sanitized_url contains 'vimeo.com/'
    assign video_id = sanitized_url | split: '.com/' | last | split: '?' | first
    assign video_embed_url = 'https://player.vimeo.com/video/' | append: video_id | append: '?autoplay=1'
    assign video_host = 'vimeo'
  endif

  ##################################################################
  # 4) Find the latest blog post in the 'news' blog referencing this trip
  ##################################################################
  assign latest_referencing_article = blank
  assign latest_published_at = '1970-01-01'
  assign blog_handle_to_check = 'news'

  if blogs[blog_handle_to_check] and current_trip_id != ''
    for article in blogs[blog_handle_to_check].articles
      if article.metafields.custom.referenced_trip
        # Confirm the metafield has a value
        if article.metafields.custom.referenced_trip.value
          assign referenced_trip = article.metafields.custom.referenced_trip.value
          # Compare IDs
          if referenced_trip.id == current_trip_id
            if article.published_at > latest_published_at
              assign latest_published_at = article.published_at
              assign latest_referencing_article = article
            endif
          endif
        endif
      endif
    endfor
  endif

  ##################################################################
  # 5) Decide if we actually show the section
  ##################################################################
  assign has_video = video_embed_url
  assign has_blog = latest_referencing_article
  assign show_section = has_video
%}

{% if show_section %}
  <div class="trip-experience color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {% comment %} Optional title for the section {% endcomment %}
      {%- unless section.settings.title == blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        </div>
      {%- endunless -%}

      <div class="trip-experience__grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {% if has_video %}
          <div class="trip-experience__column trip-experience__column--video">
            <h3 class="trip-experience__caption">{{ 'sections.trip_experience.video_caption' | t }}</h3>
            <deferred-media
              id="Deferred-Media-{{ section.id }}-{{ video_id }}"
              class="trip-experience__media deferred-media gradient global-media-settings"
              data-media-id="{{ video_id }}"
              style="--ratio-percent: 56.25%;"
            >
              <button
                id="Deferred-Poster-{{ section.id }}-{{ video_id }}"
                class="trip-experience__poster media deferred-media__poster media--landscape"
                type="button"
                aria-label="{{ 'sections.video.load_video' | t: description: 'Trip Experience Video' | escape }}"
              >
                {% comment %} If you have a poster image, swap it in here. Otherwise, fallback placeholder: {% endcomment %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}

                <span class="deferred-media__poster-button motion-reduce">
                  <span class="svg-wrapper">
                    {{- 'icon-play.svg' | inline_asset_content -}}
                  </span>
                </span>
              </button>
              <template>
                <iframe
                  src="{{ video_embed_url }}"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  title="{{ 'sections.trip_experience.video_title' | t: trip_name: current_metaobject.name | default: 'Trip' | escape }}"
                  {% if video_host == 'youtube' %}
                    class="js-youtube"
                  {% elsif video_host == 'vimeo' %}
                    class="js-vimeo"
                  {% endif %}
                ></iframe>
              </template>
            </deferred-media>
          </div>
        {% endif %}

        {% if has_blog %}
          <div class="trip-experience__column trip-experience__column--blog">
            <h3 class="trip-experience__caption">{{ 'sections.trip_experience.blog_caption' | t }}</h3>
            {% comment %} Replace the article-card render with a custom structure {% endcomment %}
            <a href="{{ latest_referencing_article.url }}" class="trip-experience__blog-link">
              <div class="trip-experience__blog-item media media--landscape" style="--ratio-percent: 75%;"> {% comment %} Adjust ratio as needed, e.g., 75% for 4:3 or 56.25% for 16:9 {% endcomment %}
                {%- if latest_referencing_article.image -%}
                  {{ latest_referencing_article.image | image_url: width: 1200 | image_tag:
                      loading: 'lazy',
                      widths: '352, 720, 960, 1200',
                      sizes: '(min-width: 750px) calc(50vw - 5rem), calc(100vw - 4rem)',
                      alt: latest_referencing_article.image.alt | escape,
                      class: 'trip-experience__blog-image motion-reduce'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder trip-experience__blog-image' }}
                {%- endif -%}
                <div class="trip-experience__blog-title-overlay">
                  <h4 class="trip-experience__blog-title h5">{{ latest_referencing_article.title | escape }}</h4>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Experience",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.trip_experience.settings.title.label",
      "default": "Trip Experience"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.trip_experience.presets.name"
    }
  ]
}
{% endschema %}