{% comment %}
  /sections/trip-experience.liquid

  Built from scratch to:
  1) Let the user manually set a video_url (text).
  2) Let the user pick a preview_image (image_picker).
  3) Let the user pick a blog (blog setting).
  4) Let the user pick a metaobject reference (for searching articles that reference it).
{% endcomment %}

{{ 'section-trip-experience.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% liquid
  ##################################################################
  # 1) Gather user-selected settings (video URL, preview image, blog, metaobject)
  ##################################################################
  assign video_url = section.settings.video_url
  assign preview_image = section.settings.preview_image
  assign selected_blog = section.settings.blog_selection
  assign referenced_object = section.settings.referenced_metaobject

  ##################################################################
  # 2) Build an EMBED URL from video_url if possible (supports YouTube or Vimeo)
  ##################################################################
  assign video_embed_url = ''
  assign video_id = ''
  assign video_host = ''

  # Basic approach: parse only if we see youtube.com or youtu.be or vimeo.com
  # (We won't handle every URL variant, but enough to show the concept.)
  assign sanitized_url = video_url | downcase | replace: 'www.', ''

  if sanitized_url contains 'youtube.com/watch?v='
    assign video_id = sanitized_url | split: 'v=' | last | split: '&' | first
    assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id
    assign video_host = 'youtube'
  elsif sanitized_url contains 'youtu.be/'
    assign video_id = sanitized_url | split: 'youtu.be/' | last | split: '?' | first
    assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id
    assign video_host = 'youtube'
  elsif sanitized_url contains 'vimeo.com/'
    assign video_id = sanitized_url | split: '.com/' | last | split: '?' | first
    assign video_embed_url = 'https://player.vimeo.com/video/' | append: video_id
    assign video_host = 'vimeo'
  else
    # If it doesn't match known patterns, fallback to whatever user gave (some embedding might still work)
    assign video_embed_url = video_url
  endif

  ##################################################################
  # 3) Find the first article in chosen blog referencing the metaobject
  ##################################################################
  assign latest_article = blank

  if blogs[selected_blog] and referenced_object
    # We assume the referencing metafield is stored as article.metafields.custom.referenced_trip
    # (You can rename "referenced_trip" to match your actual field.)
    for article in blogs[selected_blog].articles
      if article.metafields.custom.referenced_trip
        if article.metafields.custom.referenced_trip.value == referenced_object
          assign latest_article = article
          break
        endif
      endif
    endfor
  endif

  ##################################################################
  # 4) Decide if we show the video portion or article portion
  ##################################################################
  assign has_video = video_embed_url
  assign has_article = latest_article
  assign show_section = has_video
%}

{% if show_section %}
  <div class="trip-experience color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- unless section.settings.title == blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endunless -%}

      <div class="trip-experience__grid">
        {%- if has_video -%}
          <div class="trip-experience__column trip-experience__column--video">
            <h3 class="trip-experience__caption">Watch our Experience</h3>

            <deferred-media
              class="trip-experience__media deferred-media gradient global-media-settings"
              data-media-id="{{ section.id }}-video"
              style="--ratio-percent: 56.25%;"
            >
              <button
                class="trip-experience__poster media deferred-media__poster media--landscape"
                type="button"
                aria-label="Watch our Experience"
              >
                {% comment %}
                  Use the chosen preview_image if provided, else fallback placeholder
                {% endcomment %}
                {% if preview_image != blank %}
                  <img
                    src="{{ preview_image | image_url: width: 1200 }}"
                    alt="Video Preview"
                    style="display:block; width:100%; height:100%; object-fit:cover;"
                  >
                {% else %}
                  {{ 'placeholder-image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {% endif %}

                <span class="deferred-media__poster-button motion-reduce">
                  <span class="svg-wrapper">
                    {{ 'icon-play.svg' | inline_asset_content }}
                  </span>
                </span>
              </button>
              <template>
                <iframe
                  src="{{ video_embed_url }}?autoplay=1"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  title="Watch our Experience"
                ></iframe>
              </template>
            </deferred-media>
          </div>
        {%- endif -%}

        {%- if has_article -%}
          <div class="trip-experience__column trip-experience__column--blog">
            <h3 class="trip-experience__caption">Read about our Experience</h3>
            <div class="trip-experience__blog-link" style="position: relative; display: inline-block;">
              <a href="{{ latest_article.url }}" style="text-decoration: none; color: inherit;">
                {% if latest_article.image %}
                  <img
                    src="{{ latest_article.image | image_url: width: 800, crop: 'center' }}"
                    alt="{{ latest_article.title | escape }}"
                    style="display: block; width: 100%; height: auto;"
                  >
                {% else %}
                  {{ 'placeholder-image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {% endif %}

                <div
                  style="
                    position: absolute;
                    bottom: 1rem;
                    left: 1rem;
                    color: #fff;
                    font-size: 1.5rem;
                    background-color: rgba(0,0,0,0.4);
                    padding: 0.5rem 1rem;
                    border-radius: 0.25rem;
                  "
                >
                  {{ latest_article.title }}
                </div>
              </a>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Trip Experience (Custom)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Trip Experience"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Heading H2" },
        { "value": "h1", "label": "Heading H1" },
        { "value": "h0", "label": "Heading H0" }
      ]
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Video Preview Image"
    },
    {
      "type": "blog",
      "id": "blog_selection",
      "label": "Which Blog to Search?"
    },
    {
      "type": "metaobject",
      "id": "referenced_metaobject",
      "label": "Which Metaobject to find references to?",
      "metaobject_type": "trips"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Trip Experience (Custom)"
    }
  ]
}
{% endschema %}
