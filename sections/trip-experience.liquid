{% comment %}
  /sections/trip-video-and-blog.liquid

  This section references the metaobject on a Trip detail page to:
  1) Display a YouTube video (if `trip_video_url` is set).
  2) Search the user-selected blog for an article whose `referenced_trip` metafield matches this metaobject.
  3) Display the first matching article with a "Read about our Experience" heading.

  Make sure you:
    - Have a metaobject type "Trip" with a field named `trip_video_url`.
    - In your articles, have a metafield named `referenced_trip` referencing the trip metaobject.
    - Insert this section in your metaobject template.
{% endcomment %}

{{ 'section-trip-experience.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% liquid
  ##################################################################
  # 1) Get the current metaobject (Trip) from the global `metaobject`
  ##################################################################
  assign current_trip = metaobject

  if current_trip == blank
    # Means we're not on a metaobject detail page, so let's hide the section
    assign show_section = false
  else
    assign show_section = true
  endif

  ##################################################################
  # 2) Get the trip's video URL from the `trip_video_url` field
  ##################################################################
  assign raw_video_url = ''
  if show_section and current_trip.trip_video_url
    assign raw_video_url = current_trip.trip_video_url.value
  endif

  # Basic YouTube embed logic
  assign video_embed_url = ''
  if raw_video_url != blank
    assign lower_url = raw_video_url | downcase
    # Check for watch?v= pattern or youtu.be or fallback
    if lower_url contains 'youtube.com/watch?v='
      assign video_id = lower_url | split: 'v=' | last | split: '&' | first
      assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id
    elsif lower_url contains 'youtu.be/'
      assign video_id = lower_url | split: 'youtu.be/' | last | split: '?' | first
      assign video_embed_url = 'https://www.youtube.com/embed/' | append: video_id
    else
      # If user gave an embed link, or some other format, just use raw
      assign video_embed_url = raw_video_url
    endif
  endif

  ##################################################################
  # 3) Search the selected blog for an article referencing this trip
  ##################################################################
  assign referencing_article = blank
  assign selected_blog = section.settings.blog_selection

  if show_section and blogs[selected_blog]
    for article in blogs[selected_blog].articles
      # We assume the referencing metafield is `article.metafields.custom.referenced_trip`
      if article.metafields.custom.referenced_trip
        # Compare the value of that metafield to our current_trip
        if article.metafields.custom.referenced_trip.value == current_trip
          assign referencing_article = article
          break
        endif
      endif
    endfor
  endif

  assign has_video = video_embed_url
  assign has_blog = referencing_article
  assign show_section = has_video or has_blog
%}

{% if show_section %}
  <div class="trip-experience color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- unless section.settings.title == blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {%- endunless -%}

      <div class="trip-experience__grid">
        {% if has_video %}
          <div class="trip-experience__column trip-experience__column--video">
            <h3 class="trip-experience__caption">{{ section.settings.video_heading }}</h3>
            <div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden;">
              <iframe
                src="{{ video_embed_url }}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                title="{{ section.settings.video_heading }}"
                style="position:absolute; top:0; left:0; width:100%; height:100%;"
              ></iframe>
            </div>
          </div>
        {% endif %}

        {% if has_blog %}
          <div class="trip-experience__column trip-experience__column--blog">
            <h3 class="trip-experience__caption">{{ section.settings.blog_heading }}</h3>
            <div class="trip-experience__blog-link" style="position: relative; display: inline-block;">
              <a href="{{ referencing_article.url }}" style="text-decoration: none; color: inherit;">
                {% if referencing_article.image %}
                  <img
                    src="{{ referencing_article.image | image_url: width: 800, crop: 'center' }}"
                    alt="{{ referencing_article.title | escape }}"
                    style="display: block; width: 100%; height: auto;"
                  >
                {% else %}
                  {{ 'placeholder-image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {% endif %}

                <div
                  style="
                    position: absolute;
                    bottom: 1rem;
                    left: 1rem;
                    color: #fff;
                    font-size: 1.5rem;
                    background-color: rgba(0,0,0,0.4);
                    padding: 0.5rem 1rem;
                    border-radius: 0.25rem;
                  "
                >
                  {{ referencing_article.title }}
                </div>
              </a>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Trip Video and Blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Trip Experience"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Heading H2" },
        { "value": "h1", "label": "Heading H1" },
        { "value": "h0", "label": "Heading H0" }
      ]
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Video Preview Image"
    },
    {
      "type": "blog",
      "id": "blog_selection",
      "label": "Which Blog to Search?"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Video Heading",
      "default": "Watch our Experience"
    },
    {
      "type": "text",
      "id": "blog_heading",
      "label": "Blog Heading",
      "default": "Read about our Experience"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Trip Video and Blog"
    }
  ]
}
{% endschema %}
