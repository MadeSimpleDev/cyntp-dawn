{% schema %}
{
  "name": "Animated Scoreboard",
  "settings": [
    {
      "type": "text",
      "id": "par",
      "label": "Par",
      "default": "72"
    },
    {
      "type": "text",
      "id": "yards",
      "label": "Yards",
      "default": "6800"
    },
    {
      "type": "text",
      "id": "slope",
      "label": "Slope",
      "default": "130"
    },
    {
      "type": "text",
      "id": "course_type",
      "label": "Type",
      "default": "Public"
    },
    {
      "type": "text",
      "id": "course_rating",
      "label": "Rating",
      "default": "70"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Animated Scoreboard"
    }
  ]
}
{% endschema %}

<section id="scoreboard" class="scoreboard color-{{ section.settings.color_scheme }}">
  <div class="score-container">
    <div class="score-item">
      <p class="score-value score-animated" data-target="{{ section.settings.par }}">0</p>
      <p class="score-label">Par</p>
    </div>
    <div class="score-item">
      <p class="score-value score-animated" data-target="{{ section.settings.yards }}">0</p>
      <p class="score-label">Yards</p>
    </div>
    <div class="score-item">
      <p class="score-value score-animated" data-target="{{ section.settings.slope }}">0</p>
      <p class="score-label">Slope</p>
    </div>
    <div class="score-item">
      <p class="score-value">{{ section.settings.course_type }}</p>
      <p class="score-label">Type</p>
    </div>
    <div class="score-item">
      <p class="score-value score-animated" data-target="{{ section.settings.course_rating }}">0</p>
      <p class="score-label">Rating</p>
    </div>
  </div>
</section>

<style>
  /* 🌟 Make Scoreboard a Slim Bar & Apply Shopify Color Schemes */
  .scoreboard {
    display: flex;
    justify-content: center;
  }

  /* 🌟 Ensure all items fit on mobile */
  .score-container {
    display: flex;
    justify-content: space-between;
    gap: 8px; /* Reduce space between items */
    max-width: 100%;
    width: 90%;
    flex-wrap: wrap; /* Wraps on small screens */
  }

  .score-item {
    font-weight: bold;
    flex: 1;
    min-width: 18%;
    text-align: center;
  }

  /* 🌟 Adjust Number Size */
  .score-value {
    font-weight: bold;
    font-style: oblique;
    font-size: 2.5em;
    transition: transform 0.3s ease-in-out;
    margin-bottom: 2px; /* Reduce space between number and label */
  }

  /* 🌟 Adjust Label Size */
  .score-label {
    margin-top: 0px; /* Remove extra space above label */
  }

  /* 🌟 Responsive Adjustments */
  @media (max-width: 600px) {
    .score-value {
      font-size: 1.3em;
    }

    .score-label {
      font-size: .8em;
    }

    .score-container {
      gap: 5px; /* Reduce spacing on smaller screens */
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const values = document.querySelectorAll(".score-animated");

    const animateNumbers = () => {
      values.forEach(value => {
        let target = parseInt(value.getAttribute("data-target"));
        let count = 0;
        let step = Math.ceil(target / 50);
        let interval = setInterval(() => {
          count += step;
          if (count >= target) {
            count = target;
            clearInterval(interval);
          }
          value.textContent = count;
        }, 50);
      });
    };

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateNumbers();
          observer.disconnect();
        }
      });
    }, { threshold: 0.5 });

    observer.observe(document.getElementById("scoreboard"));
  });
</script>