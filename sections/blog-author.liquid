{% schema %}
{
  "name": "Author Section",
  "settings": [],
  "presets": [
    {
      "name": "Author Section"
    }
  ]
}
{% endschema %}

{% assign author = article.metafields.custom.author.value %}

{% if author %}
  <section class="author-section">
    <div class="author-header">
      <h2 class="author-title">About the Author</h2>
      <div class="author-line"></div>
    </div>

    <div class="author-content">
      <!-- Author Image + Social Links -->
      <div class="author-image-wrapper">
        {% if author.image %}
          {{
            author.image
            | image_url: width: 150
            | image_tag: class: 'author-image', alt: author.name, widths: '100, 150, 200'
          }}
        {% endif %}
        {% if author.instagram %}
          <a href="https://instagram.com/{{ author.instagram }}" target="_blank" class="social-icon">
            {{ 'icon-instagram.svg' | inline_asset_content }}
          </a>
        {% endif %}
      </div>

      <!-- Author Info -->
      <div class="author-info">
        <h3 class="author-name">
          <strong>{{ author.name }}</strong>
          {% if author.instagram %}
            <span class="author-handle">(@{{ author.instagram }})</span>
          {% endif %}
        </h3>
        <p class="author-bio">{{ author.bio }}</p>

        <!-- Favorite Club -->
        <div class="author-extras">
          <div class="favorite-club">
            <h4><em>Favorite Club in the Bag</em></h4>
            <p>{{ author.favorite_club }}</p>
          </div>
          <div class="latest-post">
            <h4><em>Latest Post</em></h4>
            <p>
              {% if author.latest_post_url %}
                <a href="{{ author.latest_post_url }}">{{ author.latest_post_title }}</a>
              {% else %}
                No recent posts
              {% endif %}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="author-footer-line"></div>
  </section>
{% endif %}

<style>
  /* 🌟 Author Section Container */
  .author-section {
    max-width: 800px;
    margin: 40px auto;
    padding: 20px;
    font-family: inherit;
    color: black; /* Ensure text is black */
    background: white; /* White background */
    border-radius: 8px; /* Optional: Adds a polished look */
    position: relative;
    border-top: 2px solid var(--color-accent); /* Force top border */
    border-bottom: 2px solid var(--color-accent); /* Force bottom border */
    padding-top: 10px;
  }

  /* 🌟 Section Header - Golden Text & Embedded in Top Border */
  .author-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-align: center;
    margin-bottom: 20px;
  }

  /* 🌟 "About the Author" Styled as Golden & Centered */
  .author-title {
    font-size: 20px;
    font-weight: bold;
    font-style: oblique;
    color: var(--color-accent); /* Ensures golden color */
    background: white; /* Ensure background covers line */
    padding: 0 15px;
    z-index: 2;
    position: relative;
  }

  /* 🌟 Stronger Golden Line Wrapping Around "About the Author" */
  .author-header::before,
  .author-header::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: var(--color-accent);
    position: relative;
    top: 50%;
  }

  /* 🌟 Author Content Layout */
  .author-content {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* 🌟 Author Image */
  .author-image-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .author-image {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-accent);
  }

  /* 🌟 Social Icons */
  .social-icon {
    display: block;
    margin-top: 5px;
    width: 24px;
    height: 24px;
  }

  /* 🌟 Author Info */
  .author-info {
    flex: 1;
  }

  .author-name {
    font-size: 18px;
    font-weight: bold;
    font-style: oblique;
    color: black;
  }

  .author-handle {
    font-size: 14px;
    color: var(--color-secondary);
  }

  .author-bio {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 5px;
    color: black;
  }

  /* 🌟 Extras (Favorite Club & Latest Post) */
  .author-extras {
    display: flex;
    gap: 20px;
    margin-top: 10px;
  }

  .favorite-club h4,
  .latest-post h4 {
    font-size: 14px;
    font-weight: bold;
    font-style: oblique;
    color: black;
  }

  .favorite-club p,
  .latest-post p {
    font-size: 14px;
    color: black;
  }

  /* 🌟 Ensures the Bottom Golden Border is Strong */
  .author-footer-line {
    display: block;
    margin-top: 20px;
    height: 2px;
    background-color: var(--color-accent);
    width: 100%;
  }
  /* 🌟 Author Section Container - Ensure Borders Are Visible */
