{% schema %}
{
  "name": "Hero Media",
  "settings": [
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero Video"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_indicator",
      "label": "Enable Scroll Indicator",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_fade_overlay",
      "label": "Enable Bottom Fade",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "overlay_logo",
      "label": "Overlay Logo (.png)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to CYNTP"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore the best golf courses"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Discover More"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_full_height",
      "label": "Enable Full Height (100vh)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero Banner With Video or Image"
    }
  ]
}
{% endschema %}

<header class="hero-banner {{ section.settings.section_color_scheme }} {% if section.settings.enable_full_height %}full-height{% endif %}">
  <div class="hero-media-wrapper">
    {% if section.settings.hero_video %}
      {{
        section.settings.hero_video
        | video_tag:
          preload: true,
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          preload: 'none',
          class: 'hero-media'
      }}
    {% elsif section.settings.hero_image %}
      {{ section.settings.hero_image | image_url: width: 3840 | image_tag: class: 'hero-media', alt: 'Hero Image' }}
    {% endif %}
    {% if section.settings.enable_fade_overlay %}
      <div class="fade-overlay"></div>
    {% endif %}
  </div>

  <div class="hero-overlay">
    {% if section.settings.overlay_logo %}
      {{
        section.settings.overlay_logo
        | image_url: width: 320
        | image_tag: widths: '100, 200, 320', class: 'hero-logo', alt: 'Hero Logo', fetchpriority: 'high', preload: true
      }}
    {% endif %}

    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>

    {% if section.settings.button_link %}
      <a href="{{ section.settings.button_link }}" class="hero-button">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.enable_scroll_indicator %}
    <div class="scroll-indicator">▼</div>
  {% endif %}
</header>
<style>
  .hero-banner {
    position: relative;
    width: 100%;
    height: 50vh; /* Default to half height */
    overflow: hidden;
    background: transparent !important;
  }

  /* When full height is enabled, override the height */
  .hero-banner.full-height {
    height: 100vh;
  }

  /* 🌟 Media Wrapper (Handles Both Image & Video) */
  .hero-media-wrapper {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: -2; /* Keeps it behind everything */
  }

  .hero-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 🌟 Hero Content Overlay */
  .hero-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    color: white;
    width: 100%;
    padding: 0 20px;
    background: transparent !important; /* Ensures full transparency */
  }

  /* 🌟 Hero Title - Responsive Font Size */
  .hero-overlay h1 {
    font-size: clamp(28px, 4vw, 64px);
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: break-word;
    max-width: 90%;
    margin: 0 auto 10px auto;
    display: block;
    text-align: center;
  }

  /* ✅ MOBILE: Aggressive Font Shrink for Very Long Titles */
  @media (max-width: 768px) {
    .hero-overlay h1 {
      font-size: 3em;
      line-height: 1.1;
      margin-top: 20px;
      word-break: break-word;
      hyphens: auto; /* Helps break long words more naturally */
    }
  }

  /* 🌟 Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 24px;
    color: white;
    animation: bounce 1.5s infinite;
    z-index: 2; /* Ensures it remains visible */
  }

  /* 🌟 Hide Scroll Indicator when disabled */
  .scroll-indicator.hidden {
    display: none;
  }

  /* 🌟 Transparent Header Fix */
  .header-wrapper {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
     background: linear-gradient(to bottom, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.10) 80%, rgba(0, 0, 0, 0) 100%) !important;
    color: white !important;
    border-bottom: none !important;
    transition: background 0.3s ease-in-out, color 0.3s ease-in-out, border-bottom 0.3s ease-in-out;
    z-index: 1000;
  }

  /* When scrolled past, restore background */
  .scrolled-past-header .header-wrapper {
    background: var(--gradient-background) !important; /* Ensures correct background */
    color: var(--color-text) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1) !important;
  }

  /* 🌟 Ensure text/logo remains visible */
  .header-wrapper a,
  .header-wrapper svg,
  .header-wrapper .site-logo img {
    transition: color 0.3s ease-in-out, filter 0.3s ease-in-out;
  }

  /* 🌟 Improve text visibility on transparent nav */
  :not(.scrolled-past-header) .header-wrapper a,
  :not(.scrolled-past-header) .header-wrapper svg,
  :not(.scrolled-past-header) .header-wrapper .site-logo img {
    color: white !important;
    filter: brightness(100);
  }

  /* When scrolled past, remove text shadow and restore normal colors */
  .scrolled-past-header .header-wrapper a,
  .scrolled-past-header .header-wrapper svg,
  .scrolled-past-header .header-wrapper .site-logo img {
    color: var(--color-text) !important;
    text-shadow: none;
  }

  /* 🌟 When menu is open, force background */
  .menu-open header.header--has-menu {
    background: var(--gradient-background) !important;
    color: var(--color-text) !important;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-media-wrapper {
    position: relative;
  }
  .fade-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px; /* Increase this value temporarily if needed */
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%);
    pointer-events: none;
    z-index: 2;
    display: block !important;
  }
</style>
