{% comment %}
  CYNTP: Vertical Blog
  -------------------
  This section displays a vertical list of blog articles. Each article is shown in a two-column layout:
  - Left column: Article Image
  - Right column: Date, Author, Title, and Preview
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ============= Vertical Blog Specific (Container) ============= */
  .cyntp-vertical-blog__list {
    display: flex;
    flex-direction: column;
    gap: 2rem; /* Keep gap between cards */
    max-width: 70%; /* Keep container width */
    margin: 0 auto; /* Keep container centered */
  }

  /* ============= Copied Small Post Styles ============= */
  .clickable-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: none;
    border: none;
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    /* Remove margin-bottom and padding from original clickable-card */
  }
  .clickable-card:hover {
    transform: scale(1.01);
    box-shadow: 0 3px 6px rgba(0,0,0,.15);
  }
  .small-post {
    display: flex;
    gap: 1rem;
    align-items: stretch; /* Ensure columns have same height */
    /* Add background and padding here if needed, or keep transparent */
    background-color: rgb(var(--color-background));
    padding: 1rem;
    border-radius: 8px; /* Optional: Add border radius */
  }
  .small-post__image-wrap {
    flex: 0 0 200px; /* Default for mobile */
    overflow: hidden;
  }
  /* Increase image width on desktop */
  @media screen and (min-width: 750px) {
    .small-post__image-wrap {
      flex: 0 0 300px; /* Increased width for desktop */
    }
  }
  .small-post__image {
    width: 100%;
    height: 100%; /* Make image fill the container height */
    object-fit: cover;
    display: block;
  }
  /* Align text content to top */
  .small-post__content {
    display: flex;
    flex-direction: column;
    /* Align content to the top */
    justify-content: flex-start;
    flex: 1; /* Allow content to take remaining space */
  }
  /* Add style for the new tag element */
  .article-tag {
    display: inline-block;
    background-color: red;
    color: white;
    padding: 0.2em 0.6em;
    font-size: 0.8rem;
    font-weight: bold;
    text-transform: uppercase;
    border-radius: 3px;
    margin-bottom: 0.5rem; /* Space below tag */
  }
  /* Styles for new meta structure */
  .small-post__meta-desktop { display: none; } /* Hide by default */
  .small-post__meta-mobile { display: block; } /* Show by default */
  .small-post__meta-desktop .article-tag,
  .small-post__meta-mobile .article-tag {
     margin-right: 0.5rem; /* Space between tag and date */
  }
  /* Style for date part - now black */
  .small-post__date {
     font-size: .875rem;
     color: #000; /* Black color */
  }
  /* Style for meta containers - now black, remove opacity */
  .small-post__meta-desktop,
  .small-post__meta-mobile {
     margin-bottom: 0.5rem; /* Space below meta line */
     font-size:.875rem;
     color: #000; /* Black color */
     text-wrap: pretty; /* Apply pretty wrap */
  }
  /* Increase font sizes for small posts */
  .small-post__title {
    font-size: 1.5rem !important; /* Increased size */
    font-weight: bold !important;
    margin: 0 0 0.4rem !important;
    text-wrap: balance; /* Add text wrapping */
    color: inherit; /* Ensure title inherits link color */
    text-decoration: none; /* Remove underline from title itself */
  }
  .small-post__title:hover {
    text-decoration: underline; /* Add underline on hover */
  }
  .small-post__excerpt {
    font-size: 1rem !important; /* Increased size */
    line-height: 1.5 !important;
    text-wrap: pretty; /* Add text wrapping */
  }

  /* Media Queries for Small Post Meta and Excerpt */
  @media screen and (min-width: 750px) {
    .small-post__meta-desktop {
      display: block; /* Show desktop meta */
      font-size: 0.95rem; /* Slightly larger on desktop */
    }
    .small-post__meta-mobile { display: none; } /* Hide mobile meta */
    .small-post__excerpt { display: block !important; } /* Ensure excerpt shows on desktop */
  }

  @media screen and (max-width: 749px) {
    .small-post__excerpt { display: none; } /* Hide excerpt on mobile */
    .small-post__meta-desktop { display: none; } /* Ensure desktop meta hidden */
    .small-post__meta-mobile { display: block; } /* Ensure mobile meta shown */
  }
  /* ============= End Copied Styles ============= */


  /* ============= Keep Heading Styles ============= */
  .cyntp-vertical-blog__heading-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    position: relative;
    padding: 10px 0;
    margin-bottom: 2rem;
  }

  .cyntp-vertical-blog__heading-wrapper::before,
  .cyntp-vertical-blog__heading-wrapper::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: #c3996b !important; /* Golden Color */
    display: block;
  }

  .cyntp-vertical-blog__heading-wrapper::before {
    margin-right: 15px;
  }

  .cyntp-vertical-blog__heading-wrapper::after {
    margin-left: 15px;
  }

  .cyntp-vertical-blog__heading {
    font-size: 22px;
    font-weight: bold;
    text-transform: uppercase;
    color: #c3996b !important;
    position: relative;
    background-color: var(--color-background);
    padding: 0 20px;
    z-index: 2;
    white-space: nowrap;
    margin: 0;
    text-wrap: balance; /* Add text wrapping */
  }

  /* ============= Keep View All Button Styles ============= */
  .cyntp-vertical-blog__view-all {
    text-align: center;
    margin-top: 2rem;
  }

  .cyntp-vertical-blog__view-all .button {
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
  }

  .cyntp-vertical-blog__view-all .button:hover {
    opacity: 0.9;
  }
{%- endstyle -%}

{%- liquid
  assign posts_displayed = section.settings.blog.articles_count
  if section.settings.post_limit < section.settings.blog.articles_count
    assign posts_displayed = section.settings.post_limit
  endif
-%}

<div class="section-{{ section.id }}-padding">
  {%- unless section.settings.heading == blank -%}
    <div class="cyntp-vertical-blog__heading-wrapper">
      <h2 class="cyntp-vertical-blog__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    </div>
  {%- endunless -%}

  {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
    <div class="cyntp-vertical-blog__list">
      {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
        {% comment %} Start copied small-post structure {% endcomment %}
        {% assign cardClass = "small-post" %}
        {% assign widthVal = 1000 %}

        <a class="{{ cardClass }} clickable-card" href="{{ article.url }}">
          {% if article.image and section.settings.show_image %}
            <div class="{{ cardClass }}__image-wrap">
              <img class="{{ cardClass }}__image"
                   src="{{ article.image | image_url: width: widthVal }}"
                   alt="{{ article.image.alt | default: '' }}"
                   loading="lazy"
              >
            </div>
          {% endif %}
          <div class="{{ cardClass }}__content">
            {% comment %} New Meta Structure for Small Post {% endcomment %}
            {% assign current_tag = article.tags | first %}
            <div class="small-post__meta-desktop">
              {% if current_tag %}<span class="article-tag">{{ current_tag | upcase }}</span>{% endif %}
              {% if section.settings.show_date %}
                <span class="small-post__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
              {% endif %}
              {% if section.settings.show_author and article.author %}
                {% if section.settings.show_date %} | {% endif %}By {{ article.author }}
              {% endif %}
            </div>
            <div class="small-post__meta-mobile">
               {% if current_tag %}<span class="article-tag">{{ current_tag | upcase }}</span>{% endif %}
               {% if section.settings.show_date %}
                 <span class="small-post__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
               {% endif %}
               {% if section.settings.show_author and article.author %}
                 {% if section.settings.show_date %} | {% endif %}By {{ article.author }}
               {% endif %}
            </div>
            {% comment %} End New Meta Structure {% endcomment %}

            <h3 class="{{ cardClass }}__title">
              {{ article.title }}
            </h3>

            {% if article.excerpt.size > 0 %}
              <p class="{{ cardClass }}__excerpt">
                {{ article.excerpt | strip_html | truncatewords: 20 }}
              </p>
            {% endif %}
          </div>
        </a>
        {% comment %} End copied small-post structure {% endcomment %}
      {%- endfor -%}
    </div>

    {%- comment %}
      If the post_limit is less than the total articles, show "View All Posts" button
    {%- endcomment %}
    {% if section.settings.post_limit < section.settings.blog.articles_count %}
      <div class="cyntp-vertical-blog__view-all">
        <a href="{{ section.settings.blog.url }}" class="button">View all posts</a>
      </div>
    {% endif %}
  {% else %}
    <p>No articles found in {{ section.settings.blog.title }}.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "CYNTP: Vertical Blog",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Vertical Blog Layout"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Number of articles to display"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show published date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "CYNTP: Vertical Blog"
    }
  ]
}
{% endschema %}