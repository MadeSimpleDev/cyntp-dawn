{% comment %}
  Custom Search Bar Section
  This section provides a simple search form that integrates with Shopify's search endpoint.
  Add it via the Theme Editor to place a search bar anywhere you like.

  Usage:
  1. Upload this file to 'sections/custom-search-bar.liquid'
  2. In the Shopify Theme Editor, add the "Custom Search Bar" section
  3. Configure as desired (e.g. enable predictive search, adjust spacing, etc.)

  Note:
  - This uses Shopify's built-in search route (routes.search_url).
  - For predictive search, the Dawn theme's `predictive-search.js` + `search-form.js` must be present and loaded.
{% endcomment %}

{%- style -%}
  .custom-search-bar {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    max-width: 60rem;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .custom-search-bar {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-search-bar__field {
    position: relative;
  }

  .custom-search-bar__input {
    width: 100%;
    /* Increase vertical padding for a taller search bar and round the borders */
    padding: 1.2rem 4rem 1.2rem 1rem;
    font-size: 1rem;
    border: 1px solid #ccc;
    border-radius: 30px;
  }

  .custom-search-bar__button,
  .custom-search-bar__reset {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    cursor: pointer;
  }

  .custom-search-bar__reset {
    right: 3rem;
    background: none;
  }

  .custom-search-bar__button {
    right: 1rem;
    /* Style the button as a green oval */
    background-color: #282F25;
    color: #fff;
    border-radius: 50px;
    padding: 0.6rem 1.2rem;
    font-size: 1rem;
    font-weight: bold;
  }
{%- endstyle -%}

<div class="custom-search-bar">
  {% capture search_form %}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <div class="custom-search-bar__field">
        <input
          class="custom-search-bar__input"
          id="{{ section.id }}-search-input"
          type="search"
          name="q"
          placeholder="{{ 'general.search.search' | t }}"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button
          type="reset"
          class="custom-search-bar__reset hidden"
          aria-label="{{ 'general.search.reset' | t }}"
        >
          <!-- Wrap the reset icon in a span with a class -->
          <span class="custom-search-bar__icon">
            {{ 'icon-reset.svg' | inline_asset_content }}
          </span>
        </button>
        <button type="submit" class="custom-search-bar__button" aria-label="{{ 'general.search.search' | t }}">
            Enter city, state, zip or course name
          </button>
          
      </div>
      <input type="hidden" name="options[prefix]" value="last">
    </form>
  {% endcapture %}

  {% if section.settings.enable_predictive_search %}
    {%- comment -%}
      If you want predictive search, your theme must have:
      - predictive-search.js
      - search-form.js
      - <predictive-search> custom element usage
    {%- endcomment -%}
    <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
      {{ search_form }}
      <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
        {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
      </div>
      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
    </predictive-search>
  {% else %}
    {%- comment -%}
      Basic non-predictive search form usage
      Still uses `search-form.js` for the reset button toggle, etc.
    {%- endcomment -%}
    <search-form>
      {{ search_form }}
    </search-form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom Search Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_predictive_search",
      "label": "Enable predictive search",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Search Bar"
    }
  ]
}
{% endschema %}
