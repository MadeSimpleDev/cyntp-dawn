{% comment %}
  FeaturedPostsCarousel.liquid

  A new section to display a scrolling carousel of blog articles (featured posts).
  This example:
  1. Looks up articles from a chosen blog handle.
  2. Slices the result to the number of posts you'd like to display.
  3. Renders them side-by-side with a scrolling slider on both desktop and mobile.

  Settings:
  - blog_handle: A required Blog handle from which to pull articles.
  - post_limit: How many articles to display in the carousel.
  - heading: Section heading text
  - heading_size: Controls the heading size class (e.g. 'h1', 'h2', etc.)
  - image_height: The ratio or size for article images if needed

  Dependencies:
  - Collides with the 'limit' filter not existing. We use the 'slice' filter instead.

  Example usage:
    In your theme, create a file named 'FeaturedPostsCarousel.liquid' in /sections
    Then add it to the homepage in the theme editor.
{% endcomment %}

{% schema %}
{
  "name": "Featured Posts Carousel",
  "settings": [
    {
      "type": "blog",
      "id": "blog_handle",
      "label": "Blog",
      "default": "news"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of posts to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Posts"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h1", "label": "Extra Large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Article Image Height",
      "options": [
        { "value": "adapt", "label": "Adapt to Image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Featured Posts Carousel"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .featured-posts-carousel-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-posts-carousel__heading {
    text-align: center;
    margin-bottom: 1rem;
  }

  /* Carousel container */
  .featured-posts-slider {
    position: relative;
    overflow: hidden; /* hide scrollbar */
    margin: 0 auto;
  }

  /* Slide list */
  .featured-posts-slider__track {
    display: flex;
    gap: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overflow-x: auto;
    padding-bottom: 1rem;
    margin: 0;
    list-style: none;
  }

  /* Hide scrollbar on Webkit */
  .featured-posts-slider__track::-webkit-scrollbar {
    display: none;
  }
  .featured-posts-slider__track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .featured-posts-slider__slide {
    flex: 0 0 auto; /* no shrink, no growth */
    scroll-snap-align: start;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    width: 300px; /* default card width on desktop */
    background: var(--color-background);
    transition: transform 0.3s ease;
    position: relative;
  }

  /* Basic arrow buttons */
  .featured-posts-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: none;
    border-radius: 50%;
    padding: 0.5rem;
    cursor: pointer;
    z-index: 10;
  }

  .featured-posts-carousel__arrow--prev {
    left: 0.5rem;
  }

  .featured-posts-carousel__arrow--next {
    right: 0.5rem;
  }
{% endstylesheet %}

<section
  class="featured-posts-carousel-wrapper color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
>
  {%- comment -%}
    Heading
  {%- endcomment -%}
  {% if section.settings.heading != blank %}
    <h2 class="featured-posts-carousel__heading {{ section.settings.heading_size }}">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  {% assign the_blog = all_blogs[section.settings.blog_handle] %}
  {% if the_blog == null %}
    <p style="text-align:center;">Please select a blog in this section's settings.</p>
  {% else %}
    {%- assign article_count = section.settings.post_limit | default: 4 -%}
    {%- assign articles_to_show = the_blog.articles | slice: 0, article_count -%}
    {% if articles_to_show.size == 0 %}
      <p style="text-align:center;">
        No articles found in the <strong>{{ the_blog.title }}</strong> blog.
      </p>
    {% else %}
      <div class="featured-posts-slider" id="FeaturedPostsSlider-{{ section.id }}">
        <button
          class="featured-posts-carousel__arrow featured-posts-carousel__arrow--prev"
          type="button"
          aria-label="Previous"
        >
          &laquo;
        </button>

        <ul class="featured-posts-slider__track" id="Track-{{ section.id }}">
          {% for article in articles_to_show %}
            <li class="featured-posts-slider__slide">
              {%- comment -%} Show image if it exists {%- endcomment -%}
              {% if article.image != blank %}
                <div
                  class="article-image"
                  style="
                    width: 100%;
                    height: {% if section.settings.image_height == 'adapt' %}auto{% else %}
                      {% case section.settings.image_height %}
                        {% when 'small' %}200px
                        {% when 'medium' %}250px
                        {% when 'large' %}350px
                        {% else %}250px
                      {% endcase %}
                    {% endif %};
                    overflow: hidden;
                    border-bottom: 1px solid var(--color-border);
                  "
                >
                  <img
                    src="{{ article.image.src | image_url: width: 600 }}"
                    alt="{{ article.image.alt | escape }}"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  >
                </div>
              {% endif %}

              <div style="padding: 1rem;">
                <h3 style="font-size:1.2em; margin:0 0 0.3rem 0;">
                  <a
                    href="{{ article.url }}"
                    style="text-decoration:none; color:inherit;"
                  >
                    {{ article.title | escape }}
                  </a>
                </h3>
                <p style="font-size:0.9em; margin-bottom:0.5rem; opacity:0.8;">
                  {% if article.published_at %}
                    {{ article.published_at | date: '%b %d, %Y' }}
                  {% endif %}
                </p>
                {% if article.excerpt != blank %}
                  <p style="font-size:0.9em; color:rgba(var(--color-foreground), 0.8);">
                    {{ article.excerpt | strip_html | truncatewords: 25 }}
                  </p>
                {% endif %}
                <a
                  href="{{ article.url }}"
                  style="font-weight:bold; display:inline-block; margin-top:0.5rem; text-decoration:underline;"
                >
                  Read more
                </a>
              </div>
            </li>
          {% endfor %}
        </ul>

        <button
          class="featured-posts-carousel__arrow featured-posts-carousel__arrow--next"
          type="button"
          aria-label="Next"
        >
          &raquo;
        </button>
      </div>
    {% endif %}
  {% endif %}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sectionId = '{{ section.id }}';
    var slider = document.getElementById('FeaturedPostsSlider-' + sectionId);
    if (!slider) return;

    var track = document.getElementById('Track-' + sectionId);
    var btnPrev = slider.querySelector('.featured-posts-carousel__arrow--prev');
    var btnNext = slider.querySelector('.featured-posts-carousel__arrow--next');
    var scrollAmount = 300; // px to scroll on click

    btnPrev.addEventListener('click', function () {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    btnNext.addEventListener('click', function () {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  });
</script>
