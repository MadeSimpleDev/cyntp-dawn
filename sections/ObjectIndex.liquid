{% schema %}
{
  "name": "Metafield Index",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Courses You Need to Play"
    }
  ],
  "presets": [
    {
      "name": "Metafield Index"
    }
  ]
}
{% endschema %}

<section class="course-index">
  <h2>{{ section.settings.title }}</h2>

  <!-- Filter Dropdown -->
  <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
    <form class="facets-vertical-form">
      <div class="facet-filters sorting caption">
        <div class="facet-filters__field">
          <h2 class="facet-filters__label caption-large text-body">
            <label for="location-filter">Filter by Location</label>
          </h2>
          <div class="select">
            <select
              id="location-filter"
              class="facet-filters__sort select__select caption-large"
              aria-describedby="a11y-refresh-page-message"
            >
              <option value="all">All Locations</option>
              {% assign locations = shop.metaobjects.course.values | map: 'state' | uniq | sort %}
              {% for location in locations %}
                <option value="{{ location | handleize }}">{{ location }}</option>
              {% endfor %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      </div>
    </form>
  </facet-filters-form>

  <!-- Course Grid -->
  <div class="course-grid">
    {% paginate shop.metaobjects.course.values by 25 %}
      {% for metaobject in shop.metaobjects.course.values %}
        <div class="course-card" data-location="{{ metaobject.state | handleize }}">
          <a href="{{ metaobject.system.url }}">
            {% if metaobject.hero_image %}
              <div
                class="course-image"
                style="background-image: url('{{ metaobject.hero_image | image_url: width: 800 }}');"
              >
                <h3 class="course-title">{{ metaobject.name }}</h3>
              </div>
            {% endif %}
          </a>
        </div>
      {% endfor %}

      {{ paginate | default_pagination }}
    {% endpaginate %}
  </div>
</section>

<style>
  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .course-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease-in-out;
  }

  .course-card:hover {
    transform: scale(1.05);
  }

  .course-image {
    width: 100%;
    height: 200px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .course-title {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    padding: 5px 10px;
    font-size: 18px;
    border-radius: 4px;
  }
  /* Shopify-style Filter Container */
  .facet-filters {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Facet Label */
  .facet-filters__label {
    font-size: 16px;
    font-weight: bold;
    color: var(--color-text);
    margin-right: 10px;
    white-space: nowrap; /* Prevents text from breaking */
  }

  /* Select Dropdown Wrapper */
  .select {
    position: relative;
    display: inline-block;
    width: 100%;
  }

  /* Select Box (Dropdown) */
  .select__select {
    appearance: none;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 16px;
    font-weight: normal;
    color: var(--color-text);
    cursor: pointer;
    width: 100%; /* Ensures it fills container */
  }

  /* Shopify-style Dropdown Arrow */
  .select .svg-wrapper {
    position: absolute;
    top: 50%;
    right: 15px;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 2; /* Ensures it's above the select */
  }

  /* Hover & Focus Effects */
  .select__select:hover,
  .select__select:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  /* 🔥 Mobile Optimization */
  @media (max-width: 768px) {
    .facet-filters {
      flex-direction: column; /* Stack items vertically */
      align-items: flex-start;
    }

    .facet-filters__field {
      width: 100%;
    }

    .select {
      width: 100%; /* Full width */
    }

    .select__select {
      width: 100%; /* Make dropdown full width */
      font-size: 18px; /* Make text larger for tapability */
      padding: 12px 16px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const filter = document.getElementById('location-filter');
    const cards = document.querySelectorAll('.course-card');

    filter.addEventListener('change', function () {
      const selectedLocation = this.value;
      console.log('Selected Location:', selectedLocation); // Debugging

      cards.forEach((card) => {
        const courseLocation = card.getAttribute('data-location');
        console.log('Course Location:', courseLocation); // Debugging

        if (selectedLocation === 'all' || courseLocation === selectedLocation) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
