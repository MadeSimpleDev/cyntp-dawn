{% assign author = article.metafields.custom.author.value %}
{% assing instagram_handle_url = 'www.instagram.com/' | append: author.instagram_handle %}

{% if author %}
  <div class="author-section color-{{ section.settings.color_scheme }}">
    <div class="author-header">
      <h2 class="author-title">About the Author</h2>
    </div>

    <div class="author-content">
      <div class="author-image-wrapper">
        {{ author.image | image_url: width: 200 | image_tag: class: 'author-image' }}
        {% comment %} <img src="{{ 'instagram-icon.svg' | asset_url }}" alt="Instagram" class="social-icon"> {% endcomment %}
      </div>

      <div class="author-info">
        <p class="author-name">
          {{ author.name }}
          <span class="author-handle"
            >(
            {{- '@' | append: author.instagram_handle | link_to: instagram_handle_url -}}
            )</span
          >
        </p>
        <p class="author-bio">{{ author.bio }}</p>

        <div class="author-extras">
          <div class="favorite-club">
            <h4>Favorite Club in the Bag</h4>
            <p>{{ author.favorite_club }}</p>
          </div>
          <div class="latest-post">
            <h4>Latest Post</h4>
            <p>{{ author.latest_post | link_to: author.latest_post_url }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="author-footer-line"></div>
  </div>
{% endif %}

<style>
  /* 🌟 Author Section Container */
  .author-section {
    max-width: 800px;
    margin: 40px auto;
    padding: 10px 20px; /* Reduced padding */
    font-family: inherit;
    border-bottom: none; /* Remove default bottom border */
    position: relative;
  }

  /* 🌟 Reduce Gap Between Top Bar & Content */
  .author-header {
    display: flex;
    align-items: center;
    justify-content: flex-start; /* Left align */
    text-align: left;
    margin-bottom: 10px; /* Reduce gap */
    position: relative;
  }

  /* 🌟 "About the Author" Styled as Golden & Left-Aligned */
  .author-title {
    font-size: 20px;
    font-weight: bold;
    font-style: oblique;
    color: #c3996b !important; /* Force golden color */
    {% comment %} background: white !important; /* Ensure it overlaps the golden line */ {% endcomment %}
    padding: 0 15px;
    z-index: 2;
    position: relative;
    white-space: nowrap;
  }

  /* 🌟 Golden Line Extending From "About the Author" */
  .author-header::after {
    content: '';
    flex-grow: 1;
    height: 2px;
    background-color: #c3996b !important; /* Force golden line */
    position: relative;
    top: 50%;
  }

  /* 🌟 Author Content Layout */
  .author-content {
    display: flex;
    align-items: center;
    gap: 15px; /* Reduced gap for tighter layout */
  }

  /* 🌟 Author Image */
  .author-image-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .author-image {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #c3996b;
  }

  /* 🌟 Social Icons */
  .social-icon {
    display: block;
    margin-top: 5px;
    width: 24px;
    height: 24px;
  }

  /* 🌟 Author Info */
  .author-info {
    flex: 1;
  }

  .author-name {
    font-size: 18px;
    font-weight: bold;
    font-style: oblique;
    color: black;
  }

  .author-handle {
    font-size: 14px;
    color: var(--color-secondary);
  }

  .author-bio {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 5px;
    color: black;
  }

  /* 🌟 Extras (Favorite Club & Latest Post) */
  .author-extras {
    display: flex;
    gap: 20px;
    margin-top: 10px;
  }

  .favorite-club h4,
  .latest-post h4 {
    font-size: 14px;
    font-weight: bold;
    font-style: oblique;
    color: black;
  }

  .favorite-club p,
  .latest-post p {
    font-size: 14px;
    color: black;
  }

  /* 🌟 Strong Bottom Golden Line (FINAL FIX) */
  .author-footer-line {
    display: block !important; /* Ensure visibility */
    height: 2px !important;
    background-color: #c3996b !important; /* Force golden color */
    width: 100% !important;
    margin-top: 15px !important; /* Ensures spacing is correct */
    position: relative;
  }
</style>
