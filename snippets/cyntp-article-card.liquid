{%- if article and article != empty -%}
  {%- liquid
    assign ratio = 1
    if media_aspect_ratio != null
      assign ratio = media_aspect_ratio
    endif
  -%}
  <a
    href="{{ article.url }}"
    class="article-card-wrapper card-wrapper underline-links-hover clickable-card"
    aria-label="Read more about {{ article.title | escape }}"
  >
    <div
      class="
        card article-card
        card--{{ settings.blog_card_style }}
        {% if media_height and media_height != 'adapt' %} article-card__image--{{ media_height }}{% endif %}
        {% if article.image %} card--media{% else %} card--text{% endif %}
      "
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div class="card__inner">
        {%- if article.image -%}
          <div class="article-card__image-wrapper">
            <div class="article-card__image media media--hover-effect">
              <img
                srcset="
                  {%- if article.image.src.width >= 165 -%}{{ article.image.src | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if article.image.src.width >= 360 -%}{{ article.image.src | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if article.image.src.width >= 533 -%}{{ article.image.src | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if article.image.src.width >= 720 -%}{{ article.image.src | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if article.image.src.width >= 1000 -%}{{ article.image.src | image_url: width: 1000 }} 1000w,{%- endif -%}
                  {%- if article.image.src.width >= 1500 -%}{{ article.image.src | image_url: width: 1500 }} 1500w,{%- endif -%}
                  {{ article.image.src | image_url }} {{ article.image.src.width }}w
                "
                src="{{ article.image.src | image_url: width: 533 }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                alt="{{ article.image.src.alt | escape }}"
                class="motion-reduce"
                loading="lazy"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
              >
            </div>
          </div>
        {%- endif -%}

        <!-- Floating Title + Date + Author + Arrow -->
        <div class="article-overlay">
          <div class="article-text">
            {%- if show_date -%}
              <span class="article-date">{{ article.published_at | time_tag: format: 'date' }}</span>
            {%- endif -%}
            <h3 class="article-title">{{ article.title | escape }}</h3>
            {%- if show_author -%}
              <span class="article-author">By: {{ article.author }}</span>
            {%- endif -%}
          </div>
          <div class="article-arrow">→</div>
        </div>
      </div>
    </div>
  </a>
{%- endif -%}

<style>
  /* 🌟 Article Card Wrapper - Entire Card Clickable */
  .clickable-card {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    cursor: pointer;
  }

  .clickable-card:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  /* 🌟 Remove default link styling */
  .clickable-card:hover .article-title a {
    text-decoration: none;
  }

  /* 🌟 Article Image */
  .article-card__image-wrapper {
    position: relative;
    width: 100%;
    height: 250px;
    border-radius: 12px;
    overflow: hidden;
  }

  .article-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 🌟 Floating Overlay */
  .article-overlay {
    position: absolute;
    height: 100%;
    width: 100%;
    bottom: 0px;
    left: 0px;
    right: 0px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.3);
    padding: 10px 15px;
    border-radius: 8px;
    color: white;
    pointer-events: none; /* Disable pointer events to allow entire card to be clickable */
  }

  /* 🌟 Text Content - Aligned to the Left */
  .article-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* 🌟 Article Title */
  .article-title {
    font-size: 18px;
    font-weight: bold;
    font-style: italic;
    margin: 3px 0;
  }

  /* 🌟 Date & Author */
  .article-date,
  .article-author {
    display: block;
    font-size: 14px;
    opacity: 0.8;
  }

  /* 🌟 Arrow - Positioned in Bottom-Right */
  .article-arrow {
    font-size: 22px;
    font-weight: bold;
    color: white;
    text-decoration: none;
  }

  /* 🌟 Responsive Adjustments */
  @media (max-width: 768px) {
    .article-overlay {
      flex-direction: column;
      align-items: flex-start;
      padding: 10px;
    }

    .article-title {
      font-size: 16px;
    }

    .article-arrow {
      font-size: 20px;
      align-self: flex-end;
    }
  }
</style>
